NODE_ENV=development
PORT=8787
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://plchat:plchat@localhost:5432/plchat?schema=public
REDIS_URL=redis://localhost:6379
JWT_ISSUER=pl-chat-api
JWT_AUDIENCE=pl-chat
JWT_ACCESS_SECRET=replace-with-32-byte-minimum-secret
JWT_REFRESH_SECRET=replace-with-another-32-byte-minimum-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SOCKET_MAX_MESSAGES_PER_MINUTE=30
UPLOAD_MAX_BYTES=104857600
