NODE_ENV=development
APP_NAME="PL CHAT"
APP_ENV=local
APP_PUBLIC_URL="http://localhost:8788"
PL_CHAT_DESKTOP_URL="http://localhost:8788"

DATABASE_URL="postgresql://user:password@localhost:5432/pl_chat_local"

SESSION_SECRET="local-change-me"
JWT_SECRET="local-change-me"
AUTH_SECRET="local-change-me"

PL_CHAT_PORT=8788
PL_CHAT_HOST="0.0.0.0"
PL_CHAT_DATA_DIR="trial-data"
# json = use local JSON only, dual = try PostgreSQL reads with JSON fallback, db = prefer PostgreSQL reads
PL_CHAT_DATA_READ_MODE="json"
PL_CHAT_DB_RETRY_MS=30000
PL_CHAT_MAX_JSON_MB=16
PL_CHAT_MAX_UPLOAD_MB=25
MAX_UPLOAD_SIZE_MB=100
FILE_UPLOAD_MODE="universal"
FILE_PREVIEW_MODE="safe-only"
ENABLE_CHUNK_UPLOAD=true
CHUNK_SIZE_MB=10
DIRECT_UPLOAD_MAX_MB=50
UPLOAD_QUEUE_CONCURRENCY=2
UPLOAD_RETRY_LIMIT=3
CHUNK_UPLOAD_EXPIRES_HOURS=24
UPLOAD_TEMP_DIR="./trial-data/tmp/uploads"
FILE_STORAGE_DRIVER="local"
ENABLE_DIRECT_UPLOAD="false"
ENABLE_MULTIPART_UPLOAD="false"
QUICK_TUNNEL_MULTIPART_CONCURRENCY=3
QUICK_TUNNEL_MULTIPART_FALLBACK_CONCURRENCY="2,1"
FILE_STORAGE_PATH="./storage/uploads"
FILE_SHARE_LINK_EXPIRES_HOURS=72
CHAT_ATTACHMENT_RETENTION_ENABLED=true
CHAT_ATTACHMENT_DOWNLOAD_EXPIRES_HOURS=72
CHAT_ATTACHMENT_DELETE_GRACE_HOURS=0
CHAT_ATTACHMENT_RETENTION_BATCH_SIZE=100
CHAT_ATTACHMENT_RETENTION_INTERVAL_MINUTES=60
ALLOW_UNKNOWN_FILE_TYPES=true
BLOCK_FILE_EXECUTION=true

S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_SESSION_TOKEN=""
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="PL CHAT <noreply@localhost>"

INVITE_TOKEN_EXPIRES_HOURS=72
EMAIL_VERIFICATION_TOKEN_EXPIRES_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
EMAIL_VERIFICATION_REQUIRED=true

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.2"
ASSISTANT_PORT=8787
