    async function fastDownloadOriginal(event, fileId, button) {
      if (event) event.preventDefault();
      const file = findFile(fileId);
      const fallbackUrl = file ? fileDownloadUrl(file) : withToken(`/api/files/${encodeURIComponent(fileId)}/download`);
      const proxyFallbackUrl = withToken(`/api/files/${encodeURIComponent(fileId)}/download?proxy=1`);
      if (button) {
        button.dataset.originalText = button.dataset.originalText || button.textContent;
        button.textContent = 'Preparing...';
        button.disabled = true;
      }
      try {
        let signedUrl = fallbackUrl;
        let signedFallbackUrl = proxyFallbackUrl;
        if (state.fileSettings.enableSignedDirectDownload) {
          const result = await api(`/api/files/${encodeURIComponent(fileId)}/signed-download`).catch(() => null);
          if (result?.url) {
            signedUrl = result.url;
            signedFallbackUrl = result.fallbackUrl ? withToken(result.fallbackUrl) : proxyFallbackUrl;
          }
        }
        const accelerated = await startBrowserAcceleratedDownload({
          url: signedUrl,
          fallbackUrl: signedFallbackUrl,
          fileName: file?.name || 'download',
          expectedBytes: file?.size || 0,
          explicit: true,
          preferFallbackFirst: true
        });
        if (!accelerated) startBrowserDownload(signedUrl, { preferNavigation: !isDesktopRuntime() });
      } catch (error) {
        console.warn('Fast download unavailable; using standard download.', error);
        startBrowserDownload(fallbackUrl, { preferNavigation: !isDesktopRuntime() });
      } finally {
        if (button) {
          button.disabled = false;
