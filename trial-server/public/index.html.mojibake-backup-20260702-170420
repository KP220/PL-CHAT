      const previousRooms = new Map(state.rooms.map((room) => [room.id, room]));
      state.rooms = (result.rooms || []).map((room) => {
        const previous = previousRooms.get(room.id);
        const unreadCount = Number(room.unreadCount ?? room.unread ?? previous?.unreadCount ?? previous?.unread ?? 0);
        return {
          ...room,
          unread: Number.isFinite(unreadCount) ? unreadCount : 0,
          unreadCount: Number.isFinite(unreadCount) ? unreadCount : 0
        };
      });
      if (state.currentRoomId && !state.rooms.some((room) => room.id === state.currentRoomId)) state.currentRoomId = '';
