    function parseContentRangeTotal(value) {
      const match = String(value || '').match(/\/(\d+)$/);
      return match ? Number(match[1]) : 0;
    }

    function browserDownloadPartPlan(totalBytes, partSizeBytes = 16 * 1024 * 1024) {
      const parts = [];
      for (let start = 0, index = 0; start < totalBytes; start += partSizeBytes, index += 1) {
        parts.push({ index, start, end: Math.min(totalBytes - 1, start + partSizeBytes - 1) });
      }
      return parts;
    }

    async function probeBrowserRangeDownload(url) {
      const response = await fetch(url, { headers: { Range: 'bytes=0-0' }, cache: 'no-store' });
      if (response.status !== 206) throw new Error(`range_probe_${response.status}`);
      response.body?.cancel?.().catch?.(() => {});
      const totalBytes = parseContentRangeTotal(response.headers.get('content-range')) || Number(response.headers.get('content-length') || 0);
      if (!totalBytes) throw new Error('range_probe_missing_size');
      return { url, totalBytes };
    }

    async function startBrowserAcceleratedDownload({ url, fallbackUrl, fileName, expectedBytes, explicit = false, preferFallbackFirst = false }) {
      if (!isDesktopRuntime() && !explicit) return false;
      if (!window.showSaveFilePicker || !window.WritableStream || !window.fetch) return false;
      const minimumBytes = 64 * 1024 * 1024;
      if (Number(expectedBytes || 0) > 0 && Number(expectedBytes || 0) < minimumBytes) return false;
      let probe = null;
      const candidates = preferFallbackFirst && fallbackUrl
        ? [fallbackUrl, url].filter(Boolean)
        : [url, fallbackUrl].filter(Boolean);
      for (const candidate of [...new Set(candidates)]) {
        try {
          probe = await probeBrowserRangeDownload(candidate);
          break;
        } catch {
          probe = null;
        }
      }
      if (!probe) return false;
      const totalBytes = Number(expectedBytes || probe.totalBytes || 0);
      if (totalBytes < minimumBytes) return false;
      let handle;
      try {
        handle = await window.showSaveFilePicker({ suggestedName: fileName || 'download' });
      } catch {
        return false;
      }
      const writable = await handle.createWritable();
      const parts = browserDownloadPartPlan(totalBytes);
      const concurrency = totalBytes >= 512 * 1024 * 1024 ? 4 : 3;
      let nextIndex = 0;
      let writeChain = Promise.resolve();
      async function worker() {
        while (nextIndex < parts.length) {
          const part = parts[nextIndex];
          nextIndex += 1;
          const response = await fetch(probe.url, {
            headers: { Range: `bytes=${part.start}-${part.end}` },
            cache: 'no-store'
          });
          if (response.status !== 206) throw new Error(`range_part_${response.status}`);
          const buffer = await response.arrayBuffer();
          writeChain = writeChain.then(() => writable.write({ type: 'write', position: part.start, data: buffer }));
          await writeChain;
        }
      }
      try {
        await Promise.all(Array.from({ length: concurrency }, () => worker()));
        await writable.close();
        return true;
      } catch (error) {
        await writable.abort().catch(() => {});
        console.warn('Browser accelerated download failed; using standard browser download.', error);
        return false;
      }
    }

