          showAuth('login');
          setNotice(friendlyError(error.message), 'error');
        }
        history.replaceState({}, '', '/');
        return;
      }
      if (path === '/reset-password' && token) {
        state.actionToken = token;
        showAuth('resetPassword');
        history.replaceState({}, '', '/');
        return;
      }
      if (path === '/invite/accept' && token) {
        state.actionToken = token;
        showAuth('acceptInvite');
        history.replaceState({}, '', '/');
        return;
      }
      if (path.startsWith('/files/share/')) {
        state.actionToken = path.split('/').pop();
      }
      if (path.startsWith('/files/') && !path.startsWith('/files/share/')) {
        state.actionToken = path.split('/').pop();
      }
      let result = null;
      try {
        result = await api('/api/me', { auth: false }).catch(() => null);
        if (!result && state.token) result = await api('/api/me');
      } catch {}
      if (result?.user) {
        const restoredToken = result.token || state.token || '';
        if (restoredToken) storeSessionToken(restoredToken);
        try {
          await enterApp(result.user, restoredToken);
          if (directUpdatesRoute) {
            switchSection('updates');
            return;
          }
          if (path.startsWith('/files/share/')) {
            const share = await api(`/api/files/share/${encodeURIComponent(state.actionToken)}`);
            switchSection('files');
            alert(`เน€เธเธดเธ”เธฅเธดเธเธเนเนเธเธฃเนเนเธเธฅเนเนเธฅเนเธง: ${share.file.name}`);
          }
          if (path.startsWith('/files/') && !path.startsWith('/files/share/')) {
            await openFileDetail(state.actionToken);
          }
        } catch (error) {
          console.warn('PL CHAT restored the session but initial data refresh failed.', error);
          setNotice('เน€เธเนเธฒเธชเธนเนเธฃเธฐเธเธเนเธฅเนเธง เนเธ•เนเนเธซเธฅเธ”เธเนเธญเธกเธนเธฅเธเธฒเธเธชเนเธงเธเนเธกเนเธชเธณเน€เธฃเนเธ เธเธฃเธธเธ“เธฒเธฃเธตเน€เธเธฃเธเธญเธตเธเธเธฃเธฑเนเธ', 'notice');
        }
        return;
      } else {
        if (state.token) bootSessionFailed = true;
        clearSessionToken();
        state.token = '';
      }
      if (await restoreTrustedDeviceSession()) return;
      showAuth(bootSessionFailed ? 'login' : 'register');
      if (bootSessionFailed) {
        setNotice('เน€เธเธชเธเธฑเธเน€เธ”เธดเธกเธซเธกเธ”เธญเธฒเธขเธธเธซเธฃเธทเธญเนเธกเนเธ•เธฃเธเธเธฑเธเน€เธเธดเธฃเนเธเน€เธงเธญเธฃเน เธเธฃเธธเธ“เธฒเน€เธเนเธฒเธชเธนเนเธฃเธฐเธเธเธญเธตเธเธเธฃเธฑเนเธ', 'notice');
      }
    }

    boot();
  </script>
