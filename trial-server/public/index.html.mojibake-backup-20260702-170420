    async function downloadImageAlbum(button, batchId) {
      const files = imageAlbumFiles(batchId);
      if (!files.length) return;
      const originalText = button?.textContent || 'เธ”เธฒเธงเธเนเนเธซเธฅเธ”เธ—เธฑเนเธเธซเธกเธ”';
