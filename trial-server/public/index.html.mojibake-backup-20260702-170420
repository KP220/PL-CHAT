    async function openNotification(item) {
      if (!item) return;
      await api(`/api/notifications/${encodeURIComponent(item.id)}/read`, { method: 'POST', body: '{}' }).catch(() => {});
      const resolved = await api(`/api/notifications/${encodeURIComponent(item.id)}/resolve`).catch(() => null);
      $('notificationDropdown').classList.add('hidden');
      await loadNotifications();
      if (resolved?.action === 'chat' && resolved.roomId) {
        switchSection('chats');
        await selectRoom(resolved.roomId, true);
        if (resolved.targetMessageId) jumpToMessage(resolved.targetMessageId);
        return;
      }
      if (resolved?.action === 'profile' && resolved.userId) {
        await openProfile(resolved.userId);
        return;
      }
      if (resolved?.action === 'file') {
        switchSection('files');
        await loadFiles({ reset: true });
        return;
      }
      if (item.roomId) {
        switchSection('chats');
        await selectRoom(item.roomId, true);
        if (item.targetMessageId) jumpToMessage(item.targetMessageId);
        return;
      }
      if (item.targetUserId || item.entityType === 'profile' || item.entityType === 'post') {
        await openProfile(item.targetUserId || item.entityId);
        return;
      }
      if (item.targetFileId || item.entityType === 'file') {
        switchSection('files');
        await loadFiles({ reset: true });
      }
    }

