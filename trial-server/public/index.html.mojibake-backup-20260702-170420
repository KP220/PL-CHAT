      const item = state.uploadItems.find((entry) => entry.id === id);
      const record = await getPersistedUploadItem(id);
      if (!item || !record?.file) return alert('เนเธกเนเธเธเนเธเธฅเนเธ•เนเธเธเธเธฑเธเธชเธณเธซเธฃเธฑเธเธญเธฑเธเนเธซเธฅเธ”เธ•เนเธญ');
      item.paused = false;
      item.cancelled = false;
