    function compactAlbumFiles(files) {
      const seen = new Set();
      return files.filter((file) => {
        const key = file?.id || `${file?.name || ''}|${file?.size || 0}|${file?.createdAt || ''}`;
        if (!file || seen.has(key)) return false;
        seen.add(key);
        return true;
      });
    }

    function imageAlbumFiles(batchId) {
      return compactAlbumFiles(state.messages
        .filter((message) => message.batchId === batchId && !message.deleted && message.attachment && isAlbumImage(message.attachment))
