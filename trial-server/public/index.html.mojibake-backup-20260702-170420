    async function saveInlineProfileEdit() {
      const saveButton = $('saveInlineProfileEdit');
      const cancelButton = $('cancelInlineProfileEdit');
      saveButton.disabled = true;
      cancelButton.disabled = true;
      saveButton.textContent = 'Saving...';
      try {
        const avatarFile = $('inlineProfileAvatarFile').files?.[0] || null;
        const coverFile = $('inlineProfileCoverFile').files?.[0] || null;
        if (avatarFile) {
          const uploaded = await uploadProfileAvatar(avatarFile);
          state.user = uploaded.user;
          $('inlineProfileAvatarUrl').value = state.user.avatar || '';
        }
        if (coverFile) {
          const uploaded = await uploadProfileCover(coverFile);
          state.user = uploaded.user;
          $('inlineProfileCoverUrl').value = state.user.cover || '';
        }
        const result = await api('/api/me/profile', {
          method: 'PATCH',
          body: JSON.stringify({
            name: $('inlineProfileName').value.trim(),
            avatar: $('inlineProfileAvatarUrl').value.trim(),
            cover: $('inlineProfileCoverUrl').value.trim(),
            bio: $('inlineProfileBio').value.trim(),
            statusMessage: $('inlineProfileStatus').value.trim(),
            department: $('inlineProfileDepartment').value.trim(),
            jobTitle: $('inlineProfileJobTitle').value.trim(),
            workMood: $('inlineProfileWorkMood').value.trim(),
            accentColor: $('inlineProfileAccentColor').value.trim(),
            favoriteQuote: $('inlineProfileFavoriteQuote').value.trim()
          })
        });
        state.user = result.user;
        state.profile = result.user;
        state.profileEditorOpen = false;
        await loadUsers();
        await openProfile(state.user.id);
        alert('Profile saved.');
      } catch (error) {
        alert(friendlyError(error.message));
        saveButton.disabled = false;
        cancelButton.disabled = false;
        saveButton.textContent = 'Save profile';
      }
    }

