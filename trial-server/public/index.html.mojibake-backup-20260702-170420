    function cancelUploadItem(id) {
      const item = state.uploadItems.find((entry) => entry.id === id);
      if (!item) return;
      item.cancelled = true;
      item.paused = false;
      item.activeController?.abort();
      item.activeRequest?.abort();
      for (const request of (item.activeRequests || [])) request.abort();
      item.status = 'cancelled';
      removePersistedUploadItem(id).catch(() => {});
      if (item.uploadId) {
        if (item.desktopUploadId && window.plChatDesktop?.cancelUpload) window.plChatDesktop.cancelUpload(item.desktopUploadId).catch(() => {});
        else if (item.uploadMode === 'multipart') cancelMultipartUpload(item.uploadId).catch(() => {});
        else cancelChunkUpload(item.uploadId).catch(() => {});
      } else if (item.desktopUploadId && window.plChatDesktop?.cancelUpload) {
        window.plChatDesktop.cancelUpload(item.desktopUploadId).catch(() => {});
      }
      renderUploadQueue();
    }

