        item.uploadMode = job.mode || item.uploadMode || 'desktop';
        item.loaded = Number(job.uploadedBytes || item.loaded || 0);
        item.progress = Math.min(100, Math.round(Number(job.progress || item.progress || 0)));
        item.speed = Number(job.speed || item.speed || 0);
        item.multipartConcurrency = Number(job.concurrency || item.multipartConcurrency || 0);
        item.receivedParts = Array.isArray(job.completedParts) ? job.completedParts : item.receivedParts;
        if (job.status === 'completed') item.status = 'done';
        else if (job.status === 'failed') {
          item.status = 'failed';
          item.error = job.error || item.error || 'desktop_upload_failed';
        } else if (job.status === 'paused') item.status = 'paused';
        else if (job.status === 'cancelled') item.status = 'cancelled';
        else if (job.status === 'retrying') item.status = 'retrying';
