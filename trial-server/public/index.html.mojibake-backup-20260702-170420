    function notificationMinutes(value) {
      const [hours, minutes] = String(value || '00:00').split(':').map(Number);
      return (hours * 60) + minutes;
    }

    function isNotificationDndActive() {
      const settings = state.notificationSettings;
      if (!settings.doNotDisturbEnabled) return false;
      const now = new Date();
      const current = (now.getHours() * 60) + now.getMinutes();
      const start = notificationMinutes(settings.doNotDisturbStart);
      const end = notificationMinutes(settings.doNotDisturbEnd);
      return start === end || (start < end ? current >= start && current < end : current >= start || current < end);
    }

    function notificationPriority(item) {
      const type = String(item?.type || '').toLowerCase();
      if (/mention|direct|private|file|system|alert/.test(type)) return 'high';
      if (/reaction|like|love/.test(type)) return 'low';
      return 'normal';
    }

    function notificationRoom(item) {
      return state.rooms.find((room) => room.id === item?.roomId);
    }

    function shouldAlertNotification(item) {
      if (!item || item.readAt || item.actorUserId === state.user?.id) return false;
      const settings = state.notificationSettings;
      if (isNotificationDndActive()) return false;
      if (item.roomId && settings.mutedRoomIds.includes(item.roomId)) return false;
      if (settings.mentionOnly && !/mention/i.test(String(item.type || ''))) return false;
      if (settings.directOnly && notificationRoom(item)?.type !== 'private' && !/mention/i.test(String(item.type || ''))) return false;
      if (state.section === 'chats' && item.roomId === state.currentRoomId && state.isNearBottom) return false;
      return true;
    }

    function ensureNotificationAudio() {
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) return false;
      state.notificationAudioContext ||= new AudioContextClass();
      if (state.notificationAudioContext.state === 'suspended') state.notificationAudioContext.resume();
      state.notificationAudioUnlocked = true;
      return true;
    }

    function playNotificationSound(priority = 'normal', force = false) {
      if ((!state.notificationSettings.soundEnabled && !force) || !ensureNotificationAudio()) return;
      const now = Date.now();
      if (!force && now - state.lastNotificationSoundAt < 2500) return;
      state.lastNotificationSoundAt = now;
      const context = state.notificationAudioContext;
      const gain = context.createGain();
      const oscillator = context.createOscillator();
      const sound = state.notificationSettings.selectedSound || 'gentle';
      const base = priority === 'high' || sound === 'urgent' ? 720 : sound === 'bright' ? 620 : 480;
      oscillator.type = sound === 'gentle' ? 'sine' : 'triangle';
      oscillator.frequency.setValueAtTime(base, context.currentTime);
      oscillator.frequency.exponentialRampToValueAtTime(base * 1.3, context.currentTime + 0.12);
      gain.gain.setValueAtTime(0.0001, context.currentTime);
      gain.gain.exponentialRampToValueAtTime(Math.max(0.01, Number(state.notificationSettings.volume || 0.55) * 0.18), context.currentTime + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, context.currentTime + 0.32);
      oscillator.connect(gain).connect(context.destination);
      oscillator.start();
      oscillator.stop(context.currentTime + 0.34);
    }

