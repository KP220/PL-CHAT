      })) return false;
      if (await startBrowserAcceleratedDownload({
        url: fallbackUrl,
        fallbackUrl,
        fileName: file?.name || 'download',
        expectedBytes: file?.size || 0
      })) return false;
      startBrowserDownload(fallbackUrl, { preferNavigation: !isDesktopRuntime() });
