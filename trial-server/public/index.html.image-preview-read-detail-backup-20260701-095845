    async function cleanupAbandonedUploadsFromAdmin() {
      const button = $('moduleCleanupOps');
      if (button) {
        button.disabled = true;
        button.textContent = 'กำลัง cleanup...';
      }
      try {
        const result = await api('/api/admin/ops/cleanup-abandoned', {
          method: 'POST',
          body: JSON.stringify({ staleHours: 24 })
        });
        alert(`Cleanup สำเร็จ ${result.cleaned || 0} คิว`);
        await loadOpsMonitoring();
      } catch (error) {
        alert(friendlyError(error.message));
      } finally {
        if (button) {
          button.disabled = false;
          button.textContent = 'Cleanup คิวค้าง';
        }
      }
    }

