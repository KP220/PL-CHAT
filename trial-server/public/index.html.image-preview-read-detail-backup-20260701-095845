    async function loadFiles(options = {}) {
      const append = Boolean(options.append);
      const reset = options.reset !== false && !append;
      if (reset) resetFilePaging();
      state.fileLoading = true;
      if (state.section === 'files') renderModule('files');
      const params = new URLSearchParams();
      if (state.fileQuery.q) params.set('q', state.fileQuery.q);
      if (state.fileQuery.category && state.fileQuery.category !== 'all') params.set('category', state.fileQuery.category);
      if (state.fileQuery.extension) params.set('extension', state.fileQuery.extension.startsWith('.') ? state.fileQuery.extension : `.${state.fileQuery.extension}`);
      if (state.fileQuery.uploaderId) params.set('uploaderId', state.fileQuery.uploaderId);
      if (state.fileQuery.source && state.fileQuery.source !== 'all') params.set('source', state.fileQuery.source);
      if (state.fileQuery.size && state.fileQuery.size !== 'all') params.set('size', state.fileQuery.size);
      if (state.fileQuery.sort) params.set('sort', state.fileQuery.sort);
      if (state.fileQuery.mine) params.set('mine', '1');
      params.set('limit', String(state.filePage.limit));
      params.set('offset', String(append ? state.filePage.offset : 0));
      try {
        const result = await api(`/api/files${params.toString() ? `?${params.toString()}` : ''}`);
        const incoming = compactFiles(result.files || []);
        state.files = append ? sortFiles(compactFiles([...(state.files || []), ...incoming])) : sortFiles(incoming);
        state.fileTotal = Number(result.total || state.files.length);
        state.filePage.offset = (append ? state.filePage.offset : 0) + (result.files || []).length;
        state.filePage.hasMore = Boolean(result.hasMore);
        state.fileSettings = {
          uploadMaxMb: result.uploadMaxMb || state.fileSettings.uploadMaxMb || 0,
          directUploadMaxMb: result.directUploadMaxMb || state.fileSettings.directUploadMaxMb || 100,
          mode: result.mode || state.fileSettings.mode,
          previewMode: result.previewMode || state.fileSettings.previewMode,
          enableChunkUpload: Boolean(result.enableChunkUpload ?? state.fileSettings.enableChunkUpload),
          enableMultipartUpload: Boolean(result.enableMultipartUpload ?? state.fileSettings.enableMultipartUpload),
          enableResumableUpload: Boolean(result.enableResumableUpload ?? state.fileSettings.enableResumableUpload),
