        : 'ใช้ได้เฉพาะ PL CHAT Desktop App';
      $('modulePrimaryAction').textContent = 'กลับ Settings';
      $('modulePrimaryAction').onclick = () => switchSection('settings');
      const body = $('moduleBody');
