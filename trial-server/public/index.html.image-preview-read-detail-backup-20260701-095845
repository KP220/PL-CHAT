    async function openActionDetails(targetType, targetId, kind = 'all', title = 'รายละเอียดกิจกรรม') {
      try {
        if (targetType === 'message' && kind === 'reads') {
          const message = state.messages.find((item) => item.id === targetId);
          if (!message) throw new Error('message_not_found');
          const readEntries = (message.readState?.readBy || []).map((actor) => ({
            id: `read-${actor.id}`,
            type: 'read',
            actor,
            createdAt: null,
            detail: 'อ่านแล้ว'
          }));
          const unreadEntries = (message.readState?.unreadBy || []).map((actor) => ({
            id: `unread-${actor.id}`,
            type: 'unread',
            actor,
            createdAt: null,
            detail: 'ยังไม่อ่าน'
          }));
          const data = {
            groups: { read: readEntries, unread: unreadEntries },
            summary: { read: readEntries.length, unread: unreadEntries.length }
          };
          state.actionDetails = { targetType, targetId, kind: 'all', title, data };
          $('actionDetailsSearch').value = '';
          $('actionDetailsModal').classList.remove('hidden');
          renderActionDetails();
          return;
        }
        const data = await api(`/api/actions/${encodeURIComponent(targetType)}/${encodeURIComponent(targetId)}`);
        state.actionDetails = { targetType, targetId, kind, title, data };
        $('actionDetailsSearch').value = '';
        $('actionDetailsModal').classList.remove('hidden');
        renderActionDetails();
      } catch (error) {
        alert(friendlyError(error.message));
      }
