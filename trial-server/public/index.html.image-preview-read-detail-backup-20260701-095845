    async function loadMessages(roomId = state.currentRoomId, options = {}) {
      if (!roomId) return;
      const previousIds = new Set(state.messages.map((message) => message.id));
      const wasNearBottom = state.isNearBottom || isMessageListNearBottom();
      const result = await api(`/api/rooms/${encodeURIComponent(roomId)}/messages`);
      state.messages = result.messages || [];
      const newCount = state.messages.filter((message) => !previousIds.has(message.id)).length;
      if (!options.forceBottom && !wasNearBottom && newCount) state.unreadNewMessageCount += newCount;
      renderMessages({ forceBottom: Boolean(options.forceBottom) || wasNearBottom });
      renderSidePanel();
      if (state.section !== 'chats') renderModule(state.section);
    }

    async function loadNotifications() {
      const result = await api('/api/notifications');
      const incoming = result.notifications || [];
      if (!state.notificationsInitialized) {
        incoming.forEach((item) => state.shownNotificationIds.add(item.id));
        state.notificationsInitialized = true;
      } else {
        incoming
          .filter((item) => !item.readAt && !state.shownNotificationIds.has(item.id))
