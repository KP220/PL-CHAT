    function showNotificationToast(item) {
      if (!state.notificationSettings.popupEnabled) return;
      const stack = $('notificationToastStack');
      while (stack.children.length >= 4) stack.firstElementChild?.remove();
      const toast = document.createElement('div');
      toast.className = 'notificationToast';
      const body = state.notificationSettings.hidePreviewContent ? 'คุณมีการแจ้งเตือนใหม่' : (item.message || item.body || '');
      toast.innerHTML = `
        <div class="notificationToastBody">
          <strong>${escapeHtml(item.title || 'PL CHAT')}</strong>
          <span>${escapeHtml(body)}</span>
          <small>${formatTime(item.createdAt)}</small>
        </div>
        <div class="notificationToastActions">
          <button class="secondary" type="button" data-open>เปิด</button>
          ${item.roomId ? '<button class="secondary" type="button" data-mute>ปิดเสียงห้อง</button>' : ''}
          <button class="secondary" type="button" data-close aria-label="ปิด">×</button>
        </div>
      `;
      toast.querySelector('[data-open]').onclick = () => { toast.remove(); openNotification(item); };
      toast.querySelector('[data-close]').onclick = () => toast.remove();
      const mute = toast.querySelector('[data-mute]');
      if (mute) mute.onclick = async () => { await muteNotificationRoom(item.roomId); toast.remove(); };
      stack.appendChild(toast);
      setTimeout(() => toast.remove(), 8000);
    }

    async function showDesktopNotification(item) {
      const body = state.notificationSettings.hidePreviewContent ? 'คุณมีการแจ้งเตือนใหม่' : (item.message || item.body || '');
      const targetUrl = item.targetUrl || (item.id ? `/notifications?id=${encodeURIComponent(item.id)}` : '/notifications');
      if (window.plChatDesktop?.showNotification) {
        await window.plChatDesktop.showNotification({
          title: item.title || 'PL CHAT',
          body,
          targetUrl,
          urgency: notificationPriority(item) === 'high' ? 'critical' : 'normal'
        }).catch(() => false);
