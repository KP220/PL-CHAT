    function switchSection(section) {
      if (section === 'admin' && !state.user?.isAdmin) section = 'home';
      if (section === 'updates') {
        state.section = 'updates';
        $('chatListPane').classList.add('hidden');
        $('chatPanel').classList.add('hidden');
        $('infoPane').classList.add('hidden');
        $('moduleView').classList.remove('hidden');
        setMobileView('module');
        document.querySelectorAll('[data-section]').forEach((button) => {
          button.classList.toggle('active', button.dataset.section === 'updates');
        });
        renderSoftwareUpdatePage();
        renderNavSummary();
        return;
      }
      state.section = section;
      const isChats = section === 'chats';
      $('chatListPane').classList.toggle('hidden', !isChats);
      $('chatPanel').classList.toggle('hidden', !isChats);
      $('infoPane').classList.toggle('hidden', !isChats);
      $('moduleView').classList.toggle('hidden', isChats);
