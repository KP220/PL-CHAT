      const updater = desktopUpdater();
      if (!updater?.restartAndInstall) throw desktopUpdaterUnavailableError();
      const result = await updater.restartAndInstall();
      state.desktopUpdateStatus = result.status || null;
      await loadDesktopUpdateStatus();
      renderSoftwareUpdatePage();
