    function markMessagesReadLocally(roomId, messageIds = []) {
      const selected = new Set(messageIds);
      for (const message of state.messages) {
        if (message.roomId !== roomId || message.userId === state.user?.id || !selected.has(message.id)) continue;
        const currentUser = state.user;
        const existingReadBy = message.readState?.readBy || [];
        message.readState = {
          ...(message.readState || {}),
          isRead: true,
          label: 'อ่านแล้ว',
          unreadCount: 0,
          readByCount: Math.max(1, Number(message.readState?.readByCount || 0)),
          readBy: existingReadBy.some((user) => user.id === currentUser?.id) || !currentUser ? existingReadBy : [...existingReadBy, currentUser],
          unreadBy: (message.readState?.unreadBy || []).filter((user) => user.id !== currentUser?.id)
        };
      }
    }

    function visibleUnreadMessageIds() {
      const list = $('messages');
      if (!list || !state.currentRoomId || state.section !== 'chats') return [];
      const listRect = list.getBoundingClientRect();
      return state.messages.filter((message) => {
        if (message.roomId !== state.currentRoomId || message.userId === state.user?.id) return false;
        if ((message.readState?.readBy || []).some((user) => user.id === state.user?.id)) return false;
        const row = document.getElementById(`message-${message.id}`);
        if (!row) return false;
        const rect = row.getBoundingClientRect();
        const visibleHeight = Math.max(0, Math.min(rect.bottom, listRect.bottom) - Math.max(rect.top, listRect.top));
        return visibleHeight >= Math.min(40, rect.height * 0.35);
      }).map((message) => message.id);
    }

    function scheduleVisibleMessageReads() {
      clearTimeout(state.visibleReadTimer);
      state.visibleReadTimer = setTimeout(async () => {
        const messageIds = visibleUnreadMessageIds().filter((id) => !state.visibleReadMessageIds.has(id));
        if (!messageIds.length) return;
        messageIds.forEach((id) => state.visibleReadMessageIds.add(id));
        try {
          const result = await api('/api/messages/read-visible', {
            method: 'POST',
            body: JSON.stringify({ messageIds })
          });
          if (!result?.ok) return;
          markMessagesReadLocally(state.currentRoomId, messageIds);
          renderMessages({ forceBottom: false });
          loadRooms().catch(() => {});
        } catch {
          messageIds.forEach((id) => state.visibleReadMessageIds.delete(id));
        }
      }, 220);
    }

