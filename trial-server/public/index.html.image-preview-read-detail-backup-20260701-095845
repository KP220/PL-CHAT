    function currentMentionQuery() {
      const input = $('messageInput');
      const beforeCursor = input.value.slice(0, input.selectionStart ?? input.value.length);
      const match = beforeCursor.match(/(?:^|\s)@([^\s@]*)$/u);
      return match ? { query: match[1].toLocaleLowerCase(), start: beforeCursor.lastIndexOf('@') } : null;
    }

    function hideMentionSuggestions() {
      $('mentionSuggestions').classList.add('hidden');
      $('mentionSuggestions').innerHTML = '';
    }

    function renderMentionSuggestions() {
      const match = currentMentionQuery();
      if (!match || !currentRoom()) {
        hideMentionSuggestions();
        return;
      }
      const users = roomMembers(currentRoom())
        .filter((user) => user.id !== state.user?.id)
        .filter((user) => !match.query || String(user.name || '').toLocaleLowerCase().includes(match.query))
        .slice(0, 8);
      if (!users.length) {
        hideMentionSuggestions();
        return;
      }
      const root = $('mentionSuggestions');
      root.innerHTML = '';
      root.classList.remove('hidden');
      for (const user of users) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'mentionOption';
        button.innerHTML = `<span class="presenceDot ${presenceClass(user)}"></span><strong>${escapeHtml(user.name)}</strong><span class="hint">${escapeHtml(presenceText(user))}</span>`;
        button.onclick = () => insertMention(user);
        root.appendChild(button);
      }
    }

    function insertMention(user) {
      const input = $('messageInput');
      const match = currentMentionQuery();
      if (!match) return;
      const cursor = input.selectionStart ?? input.value.length;
      input.value = `${input.value.slice(0, match.start)}@${user.name} ${input.value.slice(cursor)}`;
      state.mentionIds = [...new Set([...state.mentionIds, user.id])];
      hideMentionSuggestions();
      input.focus();
      input.selectionStart = input.selectionEnd = match.start + user.name.length + 2;
    }

    function syncMentionIds() {
      const text = $('messageInput').value.toLocaleLowerCase();
      state.mentionIds = state.mentionIds.filter((id) => {
        const user = state.users.find((item) => item.id === id);
        return user?.name && text.includes(`@${user.name.toLocaleLowerCase()}`);
      });
    }

    async function submitComposer() {
      if (state.sending) return;
      const room = currentRoom();
      if (!room) return;
      const text = $('messageInput').value.trim();
      const hasFiles = state.composerFiles.length > 0 || Boolean($('fileInput').files?.length);
      if (!text && !hasFiles) return;
      state.sending = true;
      $('sendButton').disabled = true;
      $('sendButton').textContent = state.editingMessageId ? 'กำลังบันทึก...' : 'กำลังส่ง...';
      try {
        if (state.editingMessageId) {
          const result = await api(`/api/messages/${encodeURIComponent(state.editingMessageId)}`, {
            method: 'PATCH',
            body: JSON.stringify({ text })
          });
          upsertMessage(result.message);
          cancelEdit();
          renderMessages({ forceBottom: state.isNearBottom });
          return;
        }
        const attachments = await uploadSelectedFiles();
        const outgoing = attachments.length ? attachments : [null];
        const sendNonce = makeClientNonce('send');
        const imageBatchId = attachments.length > 1 && attachments.every((attachment) => isAlbumImage(attachment))
          ? makeClientNonce('album')
          : null;
        for (let index = 0; index < outgoing.length; index += 1) {
          const attachment = outgoing[index];
          const result = await api(`/api/rooms/${encodeURIComponent(room.id)}/messages`, {
            method: 'POST',
            body: JSON.stringify({
              text: index === 0 ? text : '',
              attachmentId: attachment?.id || null,
              batchId: imageBatchId,
              clientNonce: `${sendNonce}-${index}`,
              replyToId: index === 0 ? (state.replyToId || null) : null,
              mentionIds: index === 0 ? state.mentionIds : []
            })
          });
          upsertMessage(result.message);
        }
        $('messageInput').value = '';
        $('fileInput').value = '';
        if ($('folderInput')) $('folderInput').value = '';
        $('fileName').textContent = 'พร้อมส่งข้อความ';
        state.composerFiles = [];
        renderComposerFilePreview();
        state.uploadItems = [];
        state.mentionIds = [];
        hideMentionSuggestions();
        renderUploadQueue();
        clearReply();
        state.unreadNewMessageCount = 0;
        renderMessages({ forceBottom: true, behavior: 'smooth' });
        renderSidePanel();
        await loadRooms();
        await loadFiles({ reset: true });
        await loadMedia();
      } finally {
        state.sending = false;
        $('sendButton').disabled = false;
        $('sendButton').textContent = state.editingMessageId ? 'บันทึก' : 'ส่ง';
      }
    }

