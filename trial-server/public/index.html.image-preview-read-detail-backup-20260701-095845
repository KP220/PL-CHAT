    }
    .selectedFilePreview {
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    }
    .filePreviewCard {
      border-radius: 12px;
      background: #F8FAFC;
    }

    @media (max-width: 1100px) {
      .app { grid-template-columns: 62px 292px minmax(0, 1fr); }
      .infoPane { display: none; }
      .message { max-width: min(720px, 82%); }
    }

    @media (max-width: 760px) {
      .app { grid-template-columns: 1fr; }
      .messages { padding: 14px 12px 18px; }
      .message { max-width: 92%; }
      .chatHead { min-height: 54px; }
    }

    /* PLCHAT_BLUE_TEXT_FIT_AND_GLOW_V2 */
