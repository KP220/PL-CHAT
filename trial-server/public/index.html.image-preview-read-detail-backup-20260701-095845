    function renderRooms() {
      const query = state.roomSearch.trim().toLowerCase();
      const list = [...state.rooms]
        .filter((room) => room.name.toLowerCase().includes(query))
        .sort((a, b) => Number(b.pinned) - Number(a.pinned) || String(a.name).localeCompare(String(b.name), 'th'));
      $('roomList').innerHTML = '';
      if (!list.length) {
        $('roomList').innerHTML = '<div class="hint">ไม่พบห้องแชท</div>';
        return;
      }
      for (const room of list) {
        const item = document.createElement('button');
        item.type = 'button';
        const unread = roomUnreadCount(room);
        const unreadLabel = unread > 99 ? '99+' : String(unread);
        item.className = `roomButton ${room.id === state.currentRoomId ? 'active' : ''} ${unread ? 'unreadRoom' : ''}`;
        const typeLabel = room.type === 'private' ? 'แชทส่วนตัว' : `${room.memberCount || state.users.length} สมาชิก`;
        item.innerHTML = `<span class="roomMain"><span class="avatar small">${room.type === 'private' ? '1:1' : '#'}</span><span class="roomText"><strong>${escapeHtml(room.name)}</strong><small>${escapeHtml(typeLabel)}</small></span></span><span class="roomMeta">${room.pinned ? '<span class="pinMark">ปัก</span>' : ''}${unread ? `<span class="roomUnreadBadge" aria-label="${unreadLabel} ข้อความยังไม่ได้อ่าน" title="${unreadLabel} ข้อความยังไม่ได้อ่าน">${unreadLabel}</span>` : ''}</span>`;
        item.onclick = () => selectRoom(room.id, true);
        $('roomList').appendChild(item);
      }
    }

    function roomUnreadCount(room) {
      const value = Number(room?.unreadCount ?? room?.unread ?? 0);
      return Number.isFinite(value) && value > 0 ? Math.floor(value) : 0;
    }

    function renderUsers() {
      const query = state.roomSearch.trim().toLowerCase();
      const users = state.users.filter((user) => user.id !== state.user?.id && (!query || user.name.toLowerCase().includes(query) || user.email.toLowerCase().includes(query)));
