    const uploadQueueDbName = 'plchat-upload-queue-v1';
    const uploadQueueStoreName = 'uploads';
    let uploadQueueDbPromise = null;

    function openUploadQueueDb() {
      if (!state.fileSettings.enablePersistentUploadQueue || !window.indexedDB) return Promise.resolve(null);
      if (uploadQueueDbPromise) return uploadQueueDbPromise;
      uploadQueueDbPromise = new Promise((resolve, reject) => {
        const request = indexedDB.open(uploadQueueDbName, 1);
        request.onupgradeneeded = () => {
          const db = request.result;
          if (!db.objectStoreNames.contains(uploadQueueStoreName)) {
            db.createObjectStore(uploadQueueStoreName, { keyPath: 'id' });
          }
        };
        request.onsuccess = () => resolve(request.result);
        request.onerror = () => reject(request.error || new Error('upload_queue_db_failed'));
      });
      return uploadQueueDbPromise;
    }

    async function uploadQueueStore(mode, operation) {
      const db = await openUploadQueueDb();
      if (!db) return null;
      return new Promise((resolve, reject) => {
        const transaction = db.transaction(uploadQueueStoreName, mode);
        const store = transaction.objectStore(uploadQueueStoreName);
        const request = operation(store);
        request.onsuccess = () => resolve(request.result);
        request.onerror = () => reject(request.error || new Error('upload_queue_store_failed'));
      });
    }

    function serializableUploadItem(item) {
      const { activeController, activeRequest, activeRequests, ...value } = item;
      return value;
    }

    async function persistUploadItem(item, file = null) {
      if (!state.fileSettings.enablePersistentUploadQueue) return;
      const existing = file ? null : await uploadQueueStore('readonly', (store) => store.get(item.id)).catch(() => null);
      await uploadQueueStore('readwrite', (store) => store.put({
        id: item.id,
        item: serializableUploadItem(item),
        file: file || existing?.file || null,
        updatedAt: new Date().toISOString()
      })).catch(() => {});
    }

    async function removePersistedUploadItem(id) {
      await uploadQueueStore('readwrite', (store) => store.delete(id)).catch(() => {});
    }

    async function getPersistedUploadItem(id) {
      return uploadQueueStore('readonly', (store) => store.get(id)).catch(() => null);
    }

    async function restorePersistentUploadQueue() {
      if (!state.fileSettings.enablePersistentUploadQueue) return;
      const records = await uploadQueueStore('readonly', (store) => store.getAll()).catch(() => []);
      const restored = (records || [])
        .filter((record) => record?.file && record?.item && !['done', 'cancelled'].includes(record.item.status))
        .map((record) => ({
          ...record.item,
          status: 'paused',
          paused: true,
          cancelled: false,
          activeController: null,
          activeRequest: null
        }));
      if (!restored.length) return;
      const knownIds = new Set(state.uploadItems.map((item) => item.id));
      state.uploadItems.push(...restored.filter((item) => !knownIds.has(item.id)));
      renderUploadQueue();
    }

    function waitWhileUploadPaused(item) {
      if (!item.paused) return Promise.resolve();
      return new Promise((resolve, reject) => {
        const check = () => {
          if (item.cancelled) return reject(new Error('upload_cancelled'));
          if (!item.paused) return resolve();
          setTimeout(check, 250);
        };
        check();
      });
    }

    async function pauseUploadItem(id) {
      const item = state.uploadItems.find((entry) => entry.id === id);
      if (!item || ['done', 'cancelled', 'failed'].includes(item.status)) return;
      item.paused = true;
      item.status = 'paused';
      item.activeController?.abort();
      item.activeRequest?.abort();
      for (const request of (item.activeRequests || [])) request.abort();
      await persistUploadItem(item);
      renderUploadQueue();
    }
    window.pauseUploadItem = pauseUploadItem;

    async function resumeUploadItem(id) {
      const item = state.uploadItems.find((entry) => entry.id === id);
      const record = await getPersistedUploadItem(id);
      if (!item || !record?.file) return alert('ไม่พบไฟล์ต้นฉบับสำหรับอัปโหลดต่อ');
      item.paused = false;
      item.cancelled = false;
      item.status = 'queued';
      item.error = '';
      item.startedAt = Date.now();
      await persistUploadItem(item, record.file);
      renderUploadQueue();
      try {
        const attachment = await uploadOneComposerFile(record.file, item);
        if (attachment && item.roomId && item.autoSendOnComplete) {
          await api(`/api/rooms/${encodeURIComponent(item.roomId)}/messages`, {
            method: 'POST',
            body: JSON.stringify({ attachmentId: attachment.id, clientNonce: `resume-${item.id}` })
          });
          if (state.currentRoomId === item.roomId) await loadMessages(item.roomId);
        }
        await removePersistedUploadItem(item.id);
      } catch (error) {
        if (!item.paused && !item.cancelled) {
          item.status = 'failed';
          item.error = error.message || 'upload_failed';
          await persistUploadItem(item);
          renderUploadQueue();
          alert(friendlyError(item.error));
        }
      }
    }
    window.resumeUploadItem = resumeUploadItem;

    async function uploadSelectedFiles() {
      const files = state.composerFiles.length ? [...state.composerFiles] : [...($('fileInput').files || [])];
      if (!files.length) return [];
      const uploads = new Array(files.length);
      state.uploadItems = files.map((file, index) => ({
        id: `${Date.now()}-${index}-${Math.random().toString(16).slice(2)}`,
        name: file.name,
        size: file.size,
        mimeType: file.type || 'application/octet-stream',
        roomId: state.currentRoomId || '',
        autoSendOnComplete: true,
        loaded: 0,
        progress: 0,
        status: 'queued',
        retries: 0,
        speed: 0,
        startedAt: 0,
        paused: false,
        cancelled: false,
        uploadId: '',
        uploadMode: '',
        receivedParts: []
      }));
      await Promise.all(state.uploadItems.map((item, index) => persistUploadItem(item, files[index])));
      renderUploadQueue();
      const concurrency = Math.min(files.length, Math.max(1, Number(state.fileSettings.uploadQueueConcurrency || 2)));
      let nextIndex = 0;
      async function worker() {
        while (nextIndex < files.length) {
          const index = nextIndex;
          nextIndex += 1;
          const file = files[index];
          const item = state.uploadItems[index];
          uploads[index] = await uploadOneComposerFile(file, item);
          await removePersistedUploadItem(item.id);
        }
      }
      await Promise.all(Array.from({ length: concurrency }, () => worker()));
      return uploads.filter(Boolean);
    }

    async function uploadOneComposerFile(file, item) {
      const params = new URLSearchParams({ name: file.name, roomId: item.roomId || state.currentRoomId || '' });
      const maxUploadBytes = Number(state.fileSettings.uploadMaxMb || 0) * 1024 * 1024;
      if (maxUploadBytes && file.size > maxUploadBytes) throw new Error(`ไฟล์ใหญ่เกินกำหนด ${state.fileSettings.uploadMaxMb} MB`);
      item.status = 'uploading';
      item.startedAt ||= Date.now();
      item.paused = false;
      await persistUploadItem(item, file);
      renderUploadQueue();
      const directLimitBytes = Number(state.fileSettings.directUploadMaxMb || 100) * 1024 * 1024;
      const chunkThresholdBytes = Math.min(Number(state.fileSettings.chunkSizeBytes || 10 * 1024 * 1024), directLimitBytes);
      const multipartThresholdBytes = Number(state.fileSettings.multipartThresholdBytes || 100 * 1024 * 1024);
      const canUseMultipart = Boolean(state.fileSettings.enableMultipartUpload)
        && file.size >= multipartThresholdBytes;
      const useChunk = !canUseMultipart && state.fileSettings.enableChunkUpload && file.size > chunkThresholdBytes;
      item.uploadMode = canUseMultipart ? 'multipart' : (useChunk ? 'chunk' : 'binary');
      await persistUploadItem(item);
      try {
        const body = canUseMultipart
          ? await uploadMultipartFile(file, item)
          : useChunk
            ? await uploadChunkedFile(file, item, params)
            : await uploadBinaryFile(`/api/uploads/binary?${params.toString()}`, file, (progress, loaded) => updateUploadProgress(item, loaded || Math.round((progress / 100) * file.size), file.size));
        item.status = 'done';
        item.progress = 100;
        item.loaded = file.size;
        await persistUploadItem(item);
        renderUploadQueue();
        return body.attachment;
      } catch (error) {
        if (item.paused || String(error.message || '').includes('upload_paused')) {
          item.status = 'paused';
          await persistUploadItem(item);
          renderUploadQueue();
          throw new Error('upload_paused');
        }
        const message = String(error.message || '');
        const canFallbackFromMultipart = canUseMultipart
          && !item.cancelled
          && (
            message.includes('multipart_upload_disabled')
            || message.includes('multipart_not_required')
            || message.includes('multipart_part_upload_failed')
            || message.includes('multipart_part_url_missing')
            || message.includes('multipart_part_etag_missing')
            || message.includes('multipart_part_upload_timeout')
            || message.includes('multipart_upload_failed')
            || message.includes('Failed to fetch')
          );
        if (canFallbackFromMultipart) {
          if (item.uploadId) await cancelMultipartUpload(item.uploadId).catch(() => {});
          const fallbackToChunk = Boolean(state.fileSettings.enableChunkUpload) && file.size > chunkThresholdBytes;
          item.uploadId = '';
          item.loaded = 0;
          item.progress = 0;
          item.retries = 0;
          item.startedAt = Date.now();
          item.status = 'uploading';
          item.error = '';
          item.uploadMode = fallbackToChunk ? 'chunk' : 'binary';
          await persistUploadItem(item, file);
          renderUploadQueue();
          const fallbackBody = fallbackToChunk
            ? await uploadChunkedFile(file, item, params)
            : await uploadBinaryFile(`/api/uploads/binary?${params.toString()}`, file, (progress, loaded) => {
                updateUploadProgress(item, loaded || Math.round((progress / 100) * file.size), file.size);
              });
          item.status = 'done';
          item.progress = 100;
          item.loaded = file.size;
          await persistUploadItem(item);
          renderUploadQueue();
          return fallbackBody.attachment;
        }
        item.status = item.cancelled ? 'cancelled' : 'failed';
        item.error = error.message || 'upload_failed';
        await persistUploadItem(item);
        renderUploadQueue();
        throw error;
      }
    }

    function updateUploadProgress(item, loaded, total, options = {}) {
      item.loaded = Math.min(Number(loaded || 0), Number(total || item.size || 0));
      item.progress = total ? Math.min(100, Math.round((item.loaded / total) * 100)) : 0;
      const elapsedSeconds = Math.max((Date.now() - Number(item.startedAt || Date.now())) / 1000, 0.1);
      item.speed = Math.round(item.loaded / elapsedSeconds);
      const now = Date.now();
      const force = Boolean(options.force) || item.progress >= 100;
      const lastRenderAt = Number(item.lastProgressRenderAt || 0);
      const lastPersistAt = Number(item.lastProgressPersistAt || 0);
      const lastProgress = Number(item.lastRenderedProgress ?? -1);
      if (force || now - lastRenderAt >= 250 || Math.abs(item.progress - lastProgress) >= 1) {
        item.lastProgressRenderAt = now;
        item.lastRenderedProgress = item.progress;
        renderUploadQueue();
      }
      if (force || now - lastPersistAt >= 1000) {
        item.lastProgressPersistAt = now;
        persistUploadItem(item).catch(() => {});
      }
    }

    function isMultipartConcurrencyRetryable(error) {
      const message = String(error?.message || error || '').toLowerCase();
      return [
        'multipart_part_upload_failed',
        'multipart_part_upload_timeout',
        'multipart_part_upload_aborted',
        'networkerror',
        'timeout',
        'econnreset',
        'failed to fetch'
      ].some((value) => message.includes(value));
    }

    function multipartFallbackPlan(initUpload, currentConcurrency) {
      const raw = [
        ...(Array.isArray(initUpload?.concurrencyFallback) ? initUpload.concurrencyFallback : []),
        ...(Array.isArray(state.fileSettings.multipartUploadConcurrencyFallback) ? state.fileSettings.multipartUploadConcurrencyFallback : [])
      ];
      return [...new Set(raw.map((value) => Number(value)).filter((value) => Number.isFinite(value) && value >= 1))]
        .filter((value) => value < currentConcurrency)
        .sort((left, right) => right - left);
    }

    async function uploadMultipartFile(file, item, forcedConcurrency = 0, attemptedConcurrency = []) {
      let init = null;
      if (item.uploadId) {
        const existing = await api(`/api/uploads/multipart/${encodeURIComponent(item.uploadId)}/status`).catch(() => null);
        if (existing?.upload && existing.upload.status !== 'completed') init = existing;
        else item.uploadId = '';
      }
      if (!init) {
        init = await api('/api/uploads/multipart/init', {
          method: 'POST',
          body: JSON.stringify({
            name: file.name,
            mimeType: file.type || 'application/octet-stream',
            size: file.size,
            roomId: item.roomId || state.currentRoomId || '',
            concurrency: Number(forcedConcurrency || state.fileSettings.multipartUploadConcurrency || state.fileSettings.uploadQueueConcurrency || 2)
          })
        });
      }
      item.uploadId = init.upload?.uploadId || init.uploadId;
      const partSize = Number(
        init.upload?.partSizeBytes
        || (Number(state.fileSettings.multipartDefaultPartSizeMb || 64) * 1024 * 1024)
        || (64 * 1024 * 1024)
      );
      const totalParts = Number(init.upload?.totalParts || Math.ceil(file.size / partSize));
      const concurrency = Math.min(
        totalParts,
        Math.max(1, Number(forcedConcurrency || init.upload?.concurrency || state.fileSettings.multipartUploadConcurrency || state.fileSettings.uploadQueueConcurrency || 2))
      );
      item.multipartConcurrency = concurrency;
      item.multipartConcurrencyRoute = init.upload?.concurrencyRoute || state.fileSettings.multipartUploadConcurrencyRoute || 'standard';
      item.multipartConcurrencyReason = init.upload?.concurrencyReason || state.fileSettings.multipartUploadConcurrencyReason || 'configured_default';
      const parts = new Array(totalParts);
      for (const savedPart of (init.upload?.parts || [])) {
        const partNumber = Number(savedPart.partNumber || 0);
        if (partNumber >= 1 && partNumber <= totalParts && savedPart.etag) {
          parts[partNumber - 1] = { partNumber, etag: savedPart.etag };
        }
      }
      const loadedByPart = new Map();
      for (let index = 0; index < parts.length; index += 1) {
        if (!parts[index]) continue;
        const start = index * partSize;
        loadedByPart.set(index + 1, Math.min(partSize, file.size - start));
      }
      let nextPartNumber = 1;
      const updatePartProgress = (partNumber, loaded) => {
        loadedByPart.set(partNumber, loaded);
        const totalLoaded = [...loadedByPart.values()].reduce((sum, value) => sum + value, 0);
        updateUploadProgress(item, totalLoaded, file.size);
      };
      const worker = async () => {
        while (nextPartNumber <= totalParts) {
          await waitWhileUploadPaused(item);
          if (item.cancelled) throw new Error('upload_cancelled');
          const partNumber = nextPartNumber;
          nextPartNumber += 1;
          if (parts[partNumber - 1]) continue;
          const start = (partNumber - 1) * partSize;
          const end = Math.min(file.size, start + partSize);
          const chunk = file.slice(start, end);
          const part = await uploadMultipartPart(
            item.uploadId,
            partNumber,
            chunk,
            item,
            (loaded) => updatePartProgress(partNumber, loaded)
          );
          parts[partNumber - 1] = part;
          updatePartProgress(partNumber, chunk.size);
        }
      };
      try {
        await Promise.all(Array.from({ length: concurrency }, () => worker()));
      } catch (error) {
        if (item.cancelled) await cancelMultipartUpload(item.uploadId).catch(() => {});
        const attempted = [...new Set([...attemptedConcurrency, concurrency])];
        const nextConcurrency = multipartFallbackPlan(init.upload, concurrency).find((value) => !attempted.includes(value));
        if (!item.cancelled && !item.paused && nextConcurrency && isMultipartConcurrencyRetryable(error)) {
          await cancelMultipartUpload(item.uploadId).catch(() => {});
          item.uploadId = '';
          item.loaded = 0;
          item.progress = 0;
          item.status = 'retrying';
          item.retries = Number(item.retries || 0) + 1;
          item.error = `retrying_with_concurrency_${nextConcurrency}`;
          await persistUploadItem(item, file);
          renderUploadQueue();
          return uploadMultipartFile(file, item, nextConcurrency, attempted);
        }
        throw error;
      }
      return api(`/api/uploads/multipart/${encodeURIComponent(item.uploadId)}/complete`, {
        method: 'POST',
        body: JSON.stringify({ parts })
      });
    }

    async function uploadChunkedFile(file, item, params) {
      let status = null;
      if (item.uploadId) {
        status = await api(`/api/uploads/chunk/${encodeURIComponent(item.uploadId)}/status`).catch(() => null);
      }
      if (!status?.upload) {
        const init = await api('/api/uploads/chunk/init', {
          method: 'POST',
          body: JSON.stringify({
            name: file.name,
            mimeType: file.type || 'application/octet-stream',
            size: file.size,
            roomId: item.roomId || state.currentRoomId || ''
          })
        });
        item.uploadId = init.upload?.uploadId || init.uploadId;
        status = init;
      }
      const upload = status.upload || {};
      const chunkSize = Number(upload.chunkSize || state.fileSettings.chunkSizeBytes || 10 * 1024 * 1024);
      const totalParts = Number(upload.totalParts || Math.ceil(file.size / chunkSize));
      const receivedParts = new Set(upload.receivedParts || item.receivedParts || []);
      item.receivedParts = [...receivedParts];
      item.loaded = Number(upload.uploadedBytes || 0);
      updateUploadProgress(item, item.loaded, file.size);
      await persistUploadItem(item, file);
      for (let index = 0; index < totalParts; index += 1) {
        await waitWhileUploadPaused(item);
        if (item.cancelled) throw new Error('upload_cancelled');
        if (receivedParts.has(index)) continue;
        const start = index * chunkSize;
        const end = Math.min(file.size, start + chunkSize);
        const chunk = file.slice(start, end);
        await uploadChunkPart(item.uploadId, index, chunk, item);
        receivedParts.add(index);
        item.receivedParts = [...receivedParts];
        updateUploadProgress(item, end, file.size);
        await persistUploadItem(item, file);
      }
      return api(`/api/uploads/chunk/${encodeURIComponent(item.uploadId)}/complete`, { method: 'POST', body: '{}' });
    }

    async function uploadChunkPart(uploadId, index, chunk, item) {
      const retryLimit = Math.max(1, Number(state.fileSettings.uploadRetryLimit || 3));
      for (let attempt = 1; attempt <= retryLimit; attempt += 1) {
        await waitWhileUploadPaused(item);
        const controller = new AbortController();
        item.activeController = controller;
        try {
          if (attempt > 1) {
            item.status = 'retrying';
            item.retries = attempt - 1;
            await persistUploadItem(item);
            renderUploadQueue();
          }
          const response = await fetch(`/api/uploads/chunk/${encodeURIComponent(uploadId)}/part?index=${index}`, {
            method: 'POST',
            headers: {
              Authorization: `Bearer ${state.token}`,
              'Content-Type': 'application/octet-stream'
            },
            body: chunk,
            signal: controller.signal
          });
          const body = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(body.error || body.message || 'chunk_upload_failed');
          item.status = 'uploading';
          item.retries = 0;
          item.activeController = null;
          return body;
        } catch (error) {
          item.activeController = null;
          if (item.paused || error?.name === 'AbortError') throw new Error('upload_paused');
          if (attempt >= retryLimit) throw error;
          await new Promise((resolve) => setTimeout(resolve, 500 * attempt));
        }
      }
      throw new Error('chunk_upload_failed');
    }

    async function uploadMultipartPart(uploadId, partNumber, chunk, item, onProgress) {
      const retryLimit = Math.max(1, Number(state.fileSettings.uploadRetryLimit || 3));
      for (let attempt = 1; attempt <= retryLimit; attempt += 1) {
        try {
          if (attempt > 1) {
            item.status = 'retrying';
            item.retries = attempt - 1;
            renderUploadQueue();
          }
          const signed = await api(`/api/uploads/multipart/${encodeURIComponent(uploadId)}/part-url`, {
            method: 'POST',
            body: JSON.stringify({ partNumber })
          });
          const result = await uploadMultipartBlobToSignedUrl(signed.part?.url, chunk, item, (partLoaded) => {
            if (onProgress) onProgress(partLoaded);
          });
          await api(`/api/uploads/multipart/${encodeURIComponent(uploadId)}/part-complete`, {
            method: 'POST',
            body: JSON.stringify({ partNumber, etag: result.etag })
          });
          await persistUploadItem(item);
          item.status = 'uploading';
          item.retries = 0;
          return {
            partNumber,
            etag: result.etag
          };
        } catch (error) {
          if (item.paused || String(error.message || '').includes('upload_paused')) throw new Error('upload_paused');
          if (attempt >= retryLimit) throw error;
          await new Promise((resolve) => setTimeout(resolve, 500 * attempt));
        }
      }
      throw new Error('multipart_upload_failed');
    }

    function uploadMultipartBlobToSignedUrl(url, chunk, item, onProgress) {
      return new Promise((resolve, reject) => {
        if (!url) {
          reject(new Error('multipart_part_url_missing'));
          return;
        }
        const xhr = new XMLHttpRequest();
        item.activeRequests ||= new Set();
        item.activeRequests.add(xhr);
        item.activeRequest = xhr;
        xhr.open('PUT', url);
        xhr.timeout = 15 * 60 * 1000;
        xhr.upload.onprogress = (event) => {
          if (event.lengthComputable && onProgress) onProgress(event.loaded, event.total);
        };
        xhr.onload = () => {
          item.activeRequests.delete(xhr);
          item.activeRequest = null;
          if (xhr.status < 200 || xhr.status >= 300) {
            reject(new Error('multipart_part_upload_failed'));
            return;
          }
          const etag = xhr.getResponseHeader('ETag') || xhr.getResponseHeader('etag') || '';
          if (!etag) {
            reject(new Error('multipart_part_etag_missing'));
            return;
          }
          resolve({ etag });
        };
        xhr.onerror = () => {
          item.activeRequests.delete(xhr);
          item.activeRequest = null;
          reject(new Error('multipart_part_upload_failed'));
        };
        xhr.onabort = () => {
          item.activeRequests.delete(xhr);
          item.activeRequest = null;
          reject(new Error(item.paused ? 'upload_paused' : 'multipart_part_upload_aborted'));
        };
        xhr.ontimeout = () => {
          item.activeRequests.delete(xhr);
          item.activeRequest = null;
          reject(new Error('multipart_part_upload_timeout'));
        };
        xhr.send(chunk);
      });
    }

    async function cancelChunkUpload(uploadId) {
      if (!uploadId) return;
      await api(`/api/uploads/chunk/${encodeURIComponent(uploadId)}/cancel`, { method: 'POST', body: '{}' });
    }

    async function cancelMultipartUpload(uploadId) {
      if (!uploadId) return;
      await api(`/api/uploads/multipart/${encodeURIComponent(uploadId)}/cancel`, { method: 'POST', body: '{}' });
    }

    function cancelUploadItem(id) {
      const item = state.uploadItems.find((entry) => entry.id === id);
      if (!item) return;
      item.cancelled = true;
      item.paused = false;
      item.activeController?.abort();
      item.activeRequest?.abort();
      for (const request of (item.activeRequests || [])) request.abort();
      item.status = 'cancelled';
      removePersistedUploadItem(id).catch(() => {});
      if (item.uploadId) {
        if (item.uploadMode === 'multipart') cancelMultipartUpload(item.uploadId).catch(() => {});
        else cancelChunkUpload(item.uploadId).catch(() => {});
      }
      renderUploadQueue();
    }

    function uploadStatusText(item) {
      const labels = {
        queued: 'รออัปโหลด',
        uploading: 'กำลังอัปโหลด',
        retrying: `ลองใหม่ครั้งที่ ${item.retries || 1}`,
        paused: 'พักไว้',
        done: 'สำเร็จ',
        failed: 'อัปโหลดไม่สำเร็จ',
        cancelled: 'ยกเลิกแล้ว'
      };
      return labels[item.status] || item.status || '';
    }

    function uploadBinaryFile(url, file, onProgress) {
      return new Promise((resolve, reject) => {
        const xhr = new XMLHttpRequest();
        xhr.open('POST', url);
        xhr.setRequestHeader('Authorization', `Bearer ${state.token}`);
        xhr.setRequestHeader('Content-Type', file.type || 'application/octet-stream');
        xhr.setRequestHeader('X-File-Name', encodeURIComponent(file.name));
        xhr.setRequestHeader('X-Room-Id', state.currentRoomId || '');
        xhr.upload.onprogress = (event) => {
          if (event.lengthComputable) onProgress(Math.round((event.loaded / event.total) * 100), event.loaded);
        };
        xhr.onload = () => {
          const body = JSON.parse(xhr.responseText || '{}');
          if (xhr.status >= 200 && xhr.status < 300) return resolve(body);
          reject(new Error(body.error || body.message || 'upload_failed'));
        };
        xhr.onerror = () => reject(new Error('upload_failed'));
        xhr.send(file);
      });
    }

    function renderUploadQueue() {
      const queue = $('uploadQueue');
      if (!state.uploadItems.length) {
        queue.classList.add('hidden');
        queue.innerHTML = '';
        return;
      }
      queue.classList.remove('hidden');
      queue.innerHTML = state.uploadItems.map((item) => `
        <div class="uploadProgress">
          <div class="row">
            <strong>${escapeHtml(item.name)}</strong>
            <span class="hint">${escapeHtml(uploadStatusText(item))} · ${item.progress}%${item.speed && item.status !== 'done' ? ` · ${formatBytes(item.speed)}/s` : ''}</span>
          </div>
          <div class="row hint">
            <span>${formatBytes(item.loaded || 0)} / ${formatBytes(item.size || 0)}</span>
            ${item.status === 'uploading' || item.status === 'retrying' || item.status === 'queued' ? `<button type="button" onclick="pauseUploadItem('${escapeHtml(item.id)}')">พัก</button><button type="button" onclick="cancelUploadItem('${escapeHtml(item.id)}')">ยกเลิก</button>` : ''}${item.status === 'paused' || item.status === 'failed' ? `<button type="button" onclick="resumeUploadItem('${escapeHtml(item.id)}')">ทำต่อ</button><button type="button" onclick="cancelUploadItem('${escapeHtml(item.id)}')">ยกเลิก</button>` : ''}
          </div>
          <div class="uploadProgressBar"><span style="width:${Number(item.progress || 0)}%"></span></div>
        </div>
      `).join('');
    }

