      --pl-line-border: #E5E7EB;
      --pl-line-text-muted: #8A97A3;
    }

    body {
      background: #fff;
      color: #111827;
    }

    .topbar {
      height: 46px;
      min-height: 46px;
      border-bottom: 1px solid var(--pl-line-border);
