          multipartMinFileSizeMb: Number(result.multipartMinFileSizeMb || state.fileSettings.multipartMinFileSizeMb || 100),
          multipartThresholdBytes: Number(result.multipartThresholdBytes || state.fileSettings.multipartThresholdBytes || 100 * 1024 * 1024),
          multipartDefaultPartSizeMb: Number(result.multipartDefaultPartSizeMb || state.fileSettings.multipartDefaultPartSizeMb || 64),
          multipartMinPartSizeMb: Number(result.multipartMinPartSizeMb || state.fileSettings.multipartMinPartSizeMb || 16),
          multipartMaxPartSizeMb: Number(result.multipartMaxPartSizeMb || state.fileSettings.multipartMaxPartSizeMb || 128),
          maxMultipartUploadMb: Number(result.maxMultipartUploadMb || state.fileSettings.maxMultipartUploadMb || 0),
          uploadQueueConcurrency: Number(result.uploadQueueConcurrency || state.fileSettings.uploadQueueConcurrency || 2),
          transferAutoTuning: result.transferAutoTuning || state.fileSettings.transferAutoTuning || { enabled: false, route: 'standard', reason: 'configured_default' },
          multipartUploadConcurrency: Number(result.multipartUploadConcurrency || state.fileSettings.multipartUploadConcurrency || result.uploadQueueConcurrency || state.fileSettings.uploadQueueConcurrency || 2),
          multipartUploadConcurrencyFallback: Array.isArray(result.multipartUploadConcurrencyFallback) ? result.multipartUploadConcurrencyFallback : (state.fileSettings.multipartUploadConcurrencyFallback || []),
