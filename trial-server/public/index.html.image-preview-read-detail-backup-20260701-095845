    function safeStorageGet(key, storage = localStorage) {
      try {
        return storage.getItem(key) || '';
      } catch {
        return '';
      }
    }

    function safeStorageSet(key, value, storage = localStorage) {
      try {
        storage.setItem(key, value);
        return true;
      } catch {
        return false;
      }
    }

    function safeStorageRemove(key, storage = localStorage) {
      try {
        storage.removeItem(key);
      } catch {}
    }

    function getStoredSessionToken() {
      return safeStorageGet(sessionTokenStorageKey)
        || safeStorageGet(sessionTokenStorageKey, sessionStorage)
        || safeStorageGet(legacySessionTokenStorageKey)
        || safeStorageGet(legacySessionTokenStorageKey, sessionStorage);
    }

    function storeSessionToken(token) {
      const value = String(token || '');
      if (!value) return false;
      const localSaved = safeStorageSet(sessionTokenStorageKey, value);
      const sessionSaved = safeStorageSet(sessionTokenStorageKey, value, sessionStorage);
      safeStorageRemove(legacySessionTokenStorageKey);
      safeStorageRemove(legacySessionTokenStorageKey, sessionStorage);
      return localSaved || sessionSaved;
    }

    function clearSessionToken() {
      safeStorageRemove(sessionTokenStorageKey);
      safeStorageRemove(sessionTokenStorageKey, sessionStorage);
      safeStorageRemove(legacySessionTokenStorageKey);
      safeStorageRemove(legacySessionTokenStorageKey, sessionStorage);
    }

    function rememberLoginEmail(email) {
      const value = String(email || '').trim().toLowerCase();
      if (!value) return;
      safeStorageSet(rememberedEmailStorageKey, value);
    }

    function fillRememberedLoginEmail() {
      const input = $('email');
      if (!input || input.value.trim()) return;
      const value = safeStorageGet(rememberedEmailStorageKey);
      if (value) input.value = value;
    }

    function isTrustedDeviceSurface() {
      const protocol = String(location.protocol || '').toLowerCase();
      const hostname = String(location.hostname || '').toLowerCase();
      const isLocal = ['localhost', '127.0.0.1', '::1', '[::1]'].includes(hostname);
      return protocol === 'https:' || isLocal;
    }

    function isDesktopRuntime() {
      return Boolean(
        window.plChatDesktop ||
        window.electronAPI ||
        window.desktopBridge
      );
    }

    function desktopUpdater() {
      if (!isDesktopRuntime()) return null;
      return window.plChatDesktop?.updater || window.electronAPI?.updater || window.desktopBridge?.updater || null;
    }

