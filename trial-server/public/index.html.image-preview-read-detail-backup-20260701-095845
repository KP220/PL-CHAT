    function renderAttachment(file) {
      if (!file) return '';
      const safeName = escapeHtml(file.name);
      const badge = fileBadge(file);
      const source = escapeHtml(fileSourceLabel(file));
      const actions = `${filePreviewButton(file)}${fileDownloadLink(file, 'primaryDownload')}${fileDetailButton(file)}${fileCopyButton(file)}`;
      if (file.canPreview && isImage(file)) {
        return `<div class="attachment imageAttachment"><button class="linkButton imageAttachmentPreview" type="button" onclick="openFilePreview('${escapeHtml(file.id)}')" aria-label="ดู ${safeName}"><img loading="lazy" src="${fileThumbnailUrl(file)}" alt="${safeName}"></button><div class="imageAttachmentFooter"><span>${formatBytes(file.size)} · ${escapeHtml(file.uploaderName || '')}</span><div class="attachmentActions">${actions}</div></div></div>`;
      }
      return `<div class="attachment"><div class="fileCard"><div class="fileIcon">${badge}</div><div class="fileMeta"><strong>${safeName}</strong><span>${fileKindLabel(file)} · ${formatBytes(file.size)} · ${escapeHtml(file.type || file.mimeType || 'ไฟล์')}</span><span>${escapeHtml(file.uploaderName || '')} · ${formatTime(file.createdAt)}</span><span class="fileSourcePill">${source}</span></div></div><div class="attachmentActions">${actions}</div></div>`;
    }

    function renderImageAlbum(messages) {
      const files = compactAlbumFiles(messages.map((message) => message.attachment).filter(Boolean));
      if (!files.length) return '';
      const gridClass = files.length === 1 ? 'one' : files.length === 3 ? 'three' : '';
      const batchId = messages[0]?.batchId || '';
      return `
        <div class="imageAlbum">
          <div class="imageAlbumGrid ${gridClass}">
            ${files.map((file) => `
              <button class="imageAlbumItem" type="button" onclick="openImageAlbum('${escapeHtml(batchId)}', '${escapeHtml(file.id)}')" aria-label="ดู ${escapeHtml(file.name)}">
                <img src="${filePreviewUrl(file)}" alt="${escapeHtml(file.name)}" loading="lazy">
              </button>
            `).join('')}
          </div>
          <div class="imageAlbumFooter">
            <span>${files.length} รูป · ไฟล์ต้นฉบับ ไม่บีบอัด</span>
            <button class="imageAlbumDownload" type="button" onclick="downloadImageAlbum(this, '${escapeHtml(batchId)}')">ดาวน์โหลดทั้งหมด</button>
          </div>
        </div>
      `;
    }

    function compactAlbumFiles(files) {
      const seen = new Set();
      return files.filter((file) => {
        const key = file?.id || `${file?.name || ''}|${file?.size || 0}|${file?.createdAt || ''}`;
        if (!file || seen.has(key)) return false;
        seen.add(key);
        return true;
      });
    }

    function imageAlbumFiles(batchId) {
      return compactAlbumFiles(state.messages
        .filter((message) => message.batchId === batchId && !message.deleted && message.attachment && isAlbumImage(message.attachment))
        .map((message) => message.attachment));
    }

    function openImageAlbum(batchId, fileId) {
      const files = imageAlbumFiles(batchId);
      const index = files.findIndex((file) => file.id === fileId);
      if (index < 0) return openFilePreview(fileId);
      state.lightboxItems = files;
      state.lightboxIndex = index;
      renderLightbox();
    }
    window.openImageAlbum = openImageAlbum;

    async function downloadImageAlbum(button, batchId) {
      const files = imageAlbumFiles(batchId);
      if (!files.length) return;
      const originalText = button?.textContent || 'ดาวน์โหลดทั้งหมด';
      if (button) {
        button.disabled = true;
        button.textContent = `กำลังดาวน์โหลด ${files.length} รูป...`;
      }
      if (window.plChatDesktop?.startBatchDownload) {
        try {
          const payload = {
            batchId,
            baseUrl: window.location.origin,
            folderName: `PL CHAT Images ${new Date().toISOString().replace(/[:.]/g, '-')}`,
            files: files.map((file, index) => ({
              url: absoluteUrl(fileDownloadUrl(file)),
              fileName: file.originalName || file.name || `image-${index + 1}`,
              expectedBytes: file.size || 0,
              fileId: file.id
            }))
          };
          const result = await window.plChatDesktop.startBatchDownload(payload);
          const folder = result?.destinationFolder || 'Downloads\\PL CHAT Downloads';
          alert(`เริ่มดาวน์โหลด ${files.length} รูปแล้ว\nเก็บไว้ที่: ${folder}`);
        } catch (error) {
          alert(`ดาวน์โหลดเป็นกลุ่มไม่ได้: ${friendlyError(error.message)}`);
        } finally {
          if (button) {
            button.disabled = false;
            button.textContent = originalText;
          }
        }
        return;
      }
      for (const file of files) {
        const link = document.createElement('a');
        link.href = fileDownloadUrl(file);
        link.download = file.originalName || file.name || '';
        link.style.display = 'none';
        document.body.appendChild(link);
        link.click();
        window.setTimeout(() => link.remove(), 1000);
      }
      window.setTimeout(() => {
        if (!button) return;
        button.disabled = false;
        button.textContent = originalText;
      }, 1200);
    }
    window.downloadImageAlbum = downloadImageAlbum;

    function messageSummary(message) {
      if (!message) return 'ข้อความ';
      if (message.deleted) return 'ข้อความถูกถอนแล้ว';
      const sticker = standardStickerMap.get(message.stickerId);
      return `${message.name || ''}: ${message.text || message.attachmentName || (sticker ? `สติ๊กเกอร์ ${sticker.label}` : 'ไฟล์แนบ')}`.slice(0, 120);
    }

    function renderSticker(stickerId) {
      const sticker = standardStickerMap.get(stickerId);
      if (!sticker) return '';
      if (sticker.imageUrl) {
