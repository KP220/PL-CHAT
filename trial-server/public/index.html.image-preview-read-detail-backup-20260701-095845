    async function selectRoom(roomId, openMobile = false) {
      state.currentRoomId = roomId;
      if (openMobile) state.mobileChatOpen = true;
      const room = currentRoom();
      if (!room) {
        renderEmptyChatState();
        return;
      }
      $('roomName').textContent = room.name;
      $('roomHint').textContent = room.type === 'private' ? 'แชทส่วนตัวที่ปลอดภัย' : `${room.memberCount || roomMembers(room).length} สมาชิก`;
      $('roomAvatar').textContent = room.type === 'private' ? '1:1' : '#';
      $('pinRoomButton').classList.remove('hidden');
      $('muteRoomButton').classList.remove('hidden');
      $('composer').classList.remove('hidden');
      $('pinRoomButton').textContent = room.pinned ? 'เลิกปักหมุด' : 'ปักหมุด';
      $('muteRoomButton').textContent = state.notificationSettings.mutedRoomIds.includes(room.id) ? 'เปิดเสียง' : 'ปิดเสียง';
      state.unreadNewMessageCount = 0;
      state.isNearBottom = true;
      state.visibleReadMessageIds.clear();
      await loadMessages(roomId, { forceBottom: true });
      const readResult = await api(`/api/rooms/${encodeURIComponent(roomId)}/read`, { method: 'POST', body: '{}' }).catch(() => null);
      if (readResult?.ok) {
        room.unread = 0;
        room.unreadCount = 0;
        renderRooms();
        renderNavSummary();
        scheduleVisibleMessageReads();
      }
      await loadRooms();
      renderSidePanel();
      if (state.section === 'chats') setMobileView('chat');
    }

