    function sortFiles(files, mode = state.fileQuery.sort) {
      const list = [...(files || [])];
      const name = (file) => String(file.name || '').toLowerCase();
      const size = (file) => Number(file.size || file.byteSize || 0);
      const time = (file) => new Date(file.createdAt || 0).getTime();
      const kind = (file) => fileKind(file);
      return list.sort((a, b) => {
        if (mode === 'oldest') return time(a) - time(b);
        if (mode === 'largest') return size(b) - size(a);
        if (mode === 'smallest') return size(a) - size(b);
        if (mode === 'name') return name(a).localeCompare(name(b), 'th');
        if (mode === 'type') return kind(a).localeCompare(kind(b), 'th') || name(a).localeCompare(name(b), 'th');
        return time(b) - time(a);
      });
    }

