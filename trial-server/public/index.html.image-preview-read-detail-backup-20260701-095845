    function moveLightbox(delta) {
      if (!state.lightboxItems.length) return;
      state.lightboxIndex = (state.lightboxIndex + delta + state.lightboxItems.length) % state.lightboxItems.length;
      renderLightbox();
    }

    function renderLightbox() {
      const file = state.lightboxItems[state.lightboxIndex];
      if (!file) return;
      $('lightbox').classList.remove('hidden');
      $('lightboxTitle').textContent = file.name || 'Preview';
      $('lightboxMeta').textContent = `${state.lightboxIndex + 1}/${state.lightboxItems.length} · ${formatBytes(file.size)} · ${file.uploaderName || ''}`;
      $('lightboxDownload').href = fileDownloadUrl(file);
      $('lightboxStage').innerHTML = '';
      if (isPreviewableImage(file)) {
        const img = document.createElement('img');
        img.src = filePreviewUrl(file);
        img.alt = file.name || 'Preview';
        $('lightboxStage').appendChild(img);
      } else {
