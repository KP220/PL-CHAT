    $('messageInput').addEventListener('paste', (event) => {
      const imageFiles = [...(event.clipboardData?.items || [])]
        .filter((item) => item.kind === 'file' && item.type.startsWith('image/'))
        .map((item, index) => {
          const file = item.getAsFile();
          if (!file) return null;
          const extension = (file.type.split('/')[1] || 'png').replace('jpeg', 'jpg');
          const genericName = !file.name || /^image\.(png|jpe?g|webp)$/i.test(file.name);
          return genericName
            ? new File([file], `screenshot-${new Date().toISOString().replace(/[:.]/g, '-')}-${index + 1}.${extension}`, { type: file.type, lastModified: Date.now() })
            : file;
        })
        .filter(Boolean);
      if (!imageFiles.length) return;
      event.preventDefault();
      setComposerFiles([...state.composerFiles, ...imageFiles], 'clipboard');
      $('messageInput').focus();
    });
    $('messageInput').addEventListener('input', () => {
      syncMentionIds();
      renderMentionSuggestions();
    });
    $('messageInput').addEventListener('keydown', async (event) => {
      if (event.key === 'Enter' && !$('mentionSuggestions').classList.contains('hidden')) {
        const first = $('mentionSuggestions').querySelector('.mentionOption');
        if (first) {
          event.preventDefault();
          first.click();
          return;
        }
      }
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault();
        await submitComposer().catch((error) => alert(friendlyError(error.message)));
      }
      if (event.key === 'Escape') {
        closeComposerMenus();
        hideMentionSuggestions();
        clearReply();
        cancelEdit();
      }
    });
    $('saveProfile').onclick = async () => {
      const saveButton = $('saveProfile');
      saveButton.disabled = true;
      saveButton.textContent = 'Saving...';
      try {
      const avatarFile = $('profileAvatarFile').files?.[0] || null;
      const coverFile = $('profileCoverFile').files?.[0] || null;
      if (avatarFile) {
        const uploaded = await uploadProfileAvatar(avatarFile);
        state.user = uploaded.user;
        $('profileAvatarUrl').value = state.user.avatar || '';
      }
      if (coverFile) {
        const uploaded = await uploadProfileCover(coverFile);
        state.user = uploaded.user;
        $('profileCoverUrl').value = state.user.cover || '';
      }
      const result = await api('/api/me/profile', {
        method: 'PATCH',
        body: JSON.stringify({
          name: $('profileName').value.trim(),
          avatar: $('profileAvatarUrl').value.trim(),
          cover: $('profileCoverUrl').value.trim(),
          bio: $('profileBio').value.trim(),
          statusMessage: $('profileStatusMessage').value.trim(),
          department: $('profileDepartment').value.trim(),
          jobTitle: $('profileJobTitle').value.trim(),
          workMood: $('profileWorkMood').value.trim(),
          accentColor: $('profileAccentColor').value.trim(),
          favoriteQuote: $('profileFavoriteQuote').value.trim()
        })
      });
      state.user = result.user;
      $('profileAvatarFile').value = '';
      $('profileCoverFile').value = '';
      renderAvatar($('profileAvatar'), state.user, 'U');
      $('status').textContent = `${state.user.name} ออนไลน์`;
      await loadUsers();
      alert('บันทึกโปรไฟล์แล้ว');
      } catch (error) {
        alert(friendlyError(error.message));
      } finally {
        saveButton.disabled = false;
        saveButton.textContent = 'บันทึกโปรไฟล์';
      }
    };
    $('presenceStatus').onchange = async () => {
      await api('/api/presence/status', {
        method: 'PATCH',
        body: JSON.stringify({ status: $('presenceStatus').value })
      }).catch(() => {});
      await loadPresence();
    };
    $('notificationButton').onclick = async () => {
      $('notificationDropdown').classList.toggle('hidden');
      await api('/api/notifications/read-all', { method: 'POST', body: '{}' }).catch(() => {});
      await loadNotifications();
    };
    $('lightboxClose').onclick = closeLightbox;
    $('lightboxPrev').onclick = () => moveLightbox(-1);
    $('lightboxNext').onclick = () => moveLightbox(1);
    $('lightbox').addEventListener('click', (event) => {
      if (event.target === $('lightbox')) closeLightbox();
    });
    $('actionDetailsClose').onclick = closeActionDetails;
    $('actionDetailsSearch').oninput = debounce(renderActionDetails, 120);
    $('actionDetailsModal').addEventListener('click', (event) => {
      if (event.target === $('actionDetailsModal')) closeActionDetails();
    });
    $('forwardMessageClose').onclick = closeForwardMessageModal;
    $('forwardMessageModal').addEventListener('click', (event) => {
      if (event.target === $('forwardMessageModal')) closeForwardMessageModal();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !$('forwardMessageModal').classList.contains('hidden')) {
        closeForwardMessageModal();
        return;
      }
      if (event.key === 'Escape' && !$('actionDetailsModal').classList.contains('hidden')) {
        closeActionDetails();
        return;
      }
      if ($('lightbox').classList.contains('hidden')) return;
      if (event.key === 'Escape') closeLightbox();
      if (event.key === 'ArrowLeft') moveLightbox(-1);
      if (event.key === 'ArrowRight') moveLightbox(1);
    });
    $('logout').onclick = async () => {
      const trustedDeviceToken = safeStorageGet(trustedDeviceStorageKey);
      if (trustedDeviceToken) {
        await api('/api/auth/trusted-device/revoke', {
          method: 'POST',
          body: JSON.stringify({ trustedDeviceToken })
        }).catch(() => {});
      }
      await api('/api/auth/logout', { method: 'POST', body: '{}' }).catch(() => {});
      clearSessionToken();
      safeStorageRemove(trustedDeviceStorageKey);
      location.reload();
    };

    function showWebUpdateFallbackStandalone() {
      document.body.classList.add('appActive');
      $('auth').style.display = 'none';
      $('app').style.display = 'grid';
      $('bottomNav').classList.add('hidden');
      $('topActions').classList.add('hidden');
      $('chatListPane').classList.add('hidden');
      $('chatPanel').classList.add('hidden');
      $('infoPane').classList.add('hidden');
      $('moduleView').classList.remove('hidden');
      $('status').textContent = 'ใช้งานผ่านเว็บ';
      setMobileView('module');
      renderSoftwareUpdatePage();
    }

    async function restoreTrustedDeviceSession() {
      const trustedDeviceToken = isTrustedDeviceSurface() ? safeStorageGet(trustedDeviceStorageKey) : '';
      if (!trustedDeviceToken) return false;
      try {
        const result = await api('/api/auth/trusted-device', {
          method: 'POST',
          body: JSON.stringify({ trustedDeviceToken })
        });
        await enterApp(result.user, result.token);
        setNotice('เข้าสู่ระบบอัตโนมัติจากอุปกรณ์ที่เชื่อถือแล้ว');
        return true;
      } catch {
        safeStorageRemove(trustedDeviceStorageKey);
        return false;
      }
    }

    async function boot() {
      const path = location.pathname;
      const token = new URLSearchParams(location.search).get('token') || '';
      let bootSessionFailed = false;
      state.token = getStoredSessionToken();
      const directUpdatesRoute = path === '/settings/updates';
      if (directUpdatesRoute && !isDesktopRuntime()) {
        showWebUpdateFallbackStandalone();
        return;
      }
      if (path === '/verify-email' && token) {
        showAuth('verifyingLink');
        try {
          await api(`/api/auth/verify-email?token=${encodeURIComponent(token)}`, { method: 'GET' });
          showAuth('login');
          setNotice('ยืนยันอีเมลสำเร็จ เข้าสู่ระบบได้เลย');
        } catch (error) {
          showAuth('login');
          setNotice(friendlyError(error.message), 'error');
        }
        history.replaceState({}, '', '/');
        return;
      }
      if (path === '/reset-password' && token) {
        state.actionToken = token;
        showAuth('resetPassword');
        history.replaceState({}, '', '/');
        return;
      }
      if (path === '/invite/accept' && token) {
        state.actionToken = token;
        showAuth('acceptInvite');
        history.replaceState({}, '', '/');
        return;
      }
      if (path.startsWith('/files/share/')) {
        state.actionToken = path.split('/').pop();
      }
      if (path.startsWith('/files/') && !path.startsWith('/files/share/')) {
        state.actionToken = path.split('/').pop();
      }
      let result = null;
      try {
        result = await api('/api/me', { auth: false }).catch(() => null);
        if (!result && state.token) result = await api('/api/me');
      } catch {}
      if (result?.user) {
        const restoredToken = result.token || state.token || '';
        if (restoredToken) storeSessionToken(restoredToken);
        try {
          await enterApp(result.user, restoredToken);
          if (directUpdatesRoute) {
            switchSection('updates');
            return;
          }
          if (path.startsWith('/files/share/')) {
            const share = await api(`/api/files/share/${encodeURIComponent(state.actionToken)}`);
            switchSection('files');
            alert(`เปิดลิงก์แชร์ไฟล์แล้ว: ${share.file.name}`);
          }
          if (path.startsWith('/files/') && !path.startsWith('/files/share/')) {
            await openFileDetail(state.actionToken);
          }
        } catch (error) {
          console.warn('PL CHAT restored the session but initial data refresh failed.', error);
          setNotice('เข้าสู่ระบบแล้ว แต่โหลดข้อมูลบางส่วนไม่สำเร็จ กรุณารีเฟรชอีกครั้ง', 'notice');
        }
        return;
      } else {
        if (state.token) bootSessionFailed = true;
        clearSessionToken();
        state.token = '';
      }
      if (await restoreTrustedDeviceSession()) return;
      showAuth(bootSessionFailed ? 'login' : 'register');
      if (bootSessionFailed) {
        setNotice('เซสชันเดิมหมดอายุหรือไม่ตรงกับเซิร์ฟเวอร์ กรุณาเข้าสู่ระบบอีกครั้ง', 'notice');
      }
    }

    boot();
  </script>
</body>
</html>




