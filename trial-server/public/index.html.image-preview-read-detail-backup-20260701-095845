    async function downloadOriginal(event, fileId, link) {
      if (event) event.preventDefault();
      const file = findFile(fileId);
      const fallbackUrl = file ? fileDownloadUrl(file) : withToken(`/api/files/${encodeURIComponent(fileId)}/download`);
      markDownloadStarted(link);
      if (state.fileSettings.enableSignedDirectDownload) {
        try {
          const result = await api(`/api/files/${encodeURIComponent(fileId)}/signed-download`);
          if (result?.url) {
            if (state.fileSettings.enableDesktopParallelDownload && window.plChatDesktop?.startParallelDownload) {
              const desktopUrl = result.url;
              const desktop = await window.plChatDesktop.startParallelDownload({
                url: desktopUrl,
                fallbackUrl,
                fileId,
                fileName: result.file?.name || file?.name || 'download',
                expectedBytes: result.file?.size || file?.size || 0,
                parallel: true
              });
              if (desktop?.job) upsertDesktopDownload(desktop.job);
              if (desktop?.ok) return false;
            }
            startBrowserDownload(result.url);
            return false;
          }
        } catch (error) {
          console.warn('Signed direct download unavailable; using legacy download.', error);
        }
      }
      startBrowserDownload(fallbackUrl);
      return false;
    }
    window.downloadOriginal = downloadOriginal;
    function markDownloadStarted(link) {
      if (!link) return true;
      link.dataset.originalText = link.dataset.originalText || link.textContent;
      link.textContent = 'กำลังดาวน์โหลด...';
      setTimeout(() => {
        link.textContent = link.dataset.originalText || 'ดาวน์โหลดต้นฉบับ';
      }, 1800);
      return true;
    }
    window.markDownloadStarted = markDownloadStarted;

