    async function downloadDesktopUpdate() {
      const manifest = state.desktopUpdateManifest || await api('/api/desktop/update-manifest');
      if (!manifest?.downloadUrl) throw new Error('ยังไม่มี installer ล่าสุดบนเครื่องโฮสต์');
      const updater = desktopUpdater();
      if (!updater?.downloadUpdate) throw desktopUpdaterUnavailableError();
      state.desktopUpdateProgress = { status: 'downloading', progress: 0, downloadedBytes: 0, totalBytes: Number(manifest.sizeBytes || 0), fileName: manifest.fileName || '' };
      renderSoftwareUpdatePage();
      const result = await updater.downloadUpdate({ manifest });
      state.desktopUpdateStatus = result.status || null;
      state.desktopUpdateProgress = { ...(state.desktopUpdateProgress || {}), status: 'completed', progress: 100 };
      await loadDesktopUpdateStatus();
      renderSoftwareUpdatePage();
    }

