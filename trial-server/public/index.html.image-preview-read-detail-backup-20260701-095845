    function allAttachments() {
      const files = state.files.length
        ? state.files
        : state.messages
          .filter((message) => message.attachment && !message.deleted)
          .map((message) => ({ ...message.attachment, roomId: message.roomId, sender: message.name, createdAt: message.createdAt }));
      return sortFiles(files);
    }

    function compactFiles(files) {
      const groups = new Map();
      for (const file of files || []) {
        const key = [
          String(file.name || '').toLowerCase(),
          Number(file.size || file.byteSize || 0),
          String(file.type || file.mimeType || '').toLowerCase(),
          String(file.uploaderId || file.userId || ''),
          String(file.roomId || file.conversationId || '')
        ].join('|');
        const existing = groups.get(key);
        if (!existing) {
          groups.set(key, { ...file, duplicateCount: 1, duplicateIds: [file.id] });
          continue;
        }
        existing.duplicateCount += 1;
        existing.duplicateIds.push(file.id);
        if (new Date(file.createdAt || 0) > new Date(existing.createdAt || 0)) {
          Object.assign(existing, { ...file, duplicateCount: existing.duplicateCount, duplicateIds: existing.duplicateIds });
        }
      }
