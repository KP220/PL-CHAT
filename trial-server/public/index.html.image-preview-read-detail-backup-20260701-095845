    async function applyInitialRoute() {
      const path = location.pathname;
      if (path === '/me' || path === '/profile') {
        await openProfile(state.user.id);
        return;
      }
      if (path.startsWith('/people/')) {
        const userId = path.split('/')[2];
        if (userId) await openProfile(userId);
        return;
      }
      if (path === '/feed' || path === '/home') {
        switchSection('home');
        return;
      }
      if (path === '/notifications') {
        const notificationId = new URLSearchParams(location.search).get('id');
        if (notificationId) {
          const notification = state.notifications.find((item) => item.id === notificationId) || { id: notificationId };
          await openNotification(notification);
          history.replaceState({}, '', '/notifications');
          return;
        }
        switchSection('notifications');
        return;
      }
      if (path === '/files') {
        switchSection('files');
        return;
      }
      if (path.startsWith('/files/') && !path.startsWith('/files/share/')) {
        const fileId = path.split('/').pop();
        if (fileId) await openFileDetail(fileId);
        return;
      }
      if (path === '/media') {
        switchSection('media');
        return;
      }
      if (path === '/settings' || path === '/settings/notifications') {
        switchSection('settings');
        return;
      }
      if (path.startsWith('/chats/')) {
        const parts = path.split('/');
        const roomId = parts[2];
        const targetMessageId = parts[3] === 'messages' ? parts[4] : '';
        if (roomId) {
          switchSection('chats');
          await selectRoom(roomId, true);
          if (targetMessageId) jumpToMessage(targetMessageId);
        }
      }
    }

