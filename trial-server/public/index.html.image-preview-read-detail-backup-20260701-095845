    function startEvents() {
      if (state.events) state.events.close();
      state.events = new EventSource(`/api/events?token=${encodeURIComponent(state.token)}`);
      state.events.addEventListener('message:new', (event) => {
        const { message } = JSON.parse(event.data);
        if (message.roomId === state.currentRoomId) {
          const exists = state.messages.some((item) => item.id === message.id);
          const wasNearBottom = state.isNearBottom || isMessageListNearBottom();
          upsertMessage(message);
          if (!exists && !wasNearBottom) state.unreadNewMessageCount += 1;
          renderMessages({ forceBottom: wasNearBottom });
          if (!exists && wasNearBottom && message.userId !== state.user?.id) {
            api(`/api/rooms/${encodeURIComponent(message.roomId)}/read`, { method: 'POST', body: '{}' })
              .then((result) => {
                if (!result?.ok) return;
                scheduleVisibleMessageReads();
                loadRooms().catch(() => {});
              })
              .catch(() => {});
          }
          renderSidePanel();
        }
        loadRooms().catch(() => {});
        loadNotifications().catch(() => {});
      });
      state.events.addEventListener('conversation.unread_count.updated', (event) => {
        const payload = JSON.parse(event.data);
        const roomId = payload.roomId || payload.conversationId;
        const unreadCount = Number(payload.unreadCount ?? payload.unread ?? 0);
        state.rooms = state.rooms.map((room) => room.id === roomId
          ? { ...room, unread: unreadCount, unreadCount }
          : room);
        renderRooms();
        renderNavSummary();
      });
      state.events.addEventListener('message:update', (event) => {
        const { message } = JSON.parse(event.data);
        state.messages = state.messages.map((item) => item.id === message.id ? message : item);
        renderMessages({ forceBottom: state.isNearBottom });
        renderSidePanel();
      });
      state.events.addEventListener('room:read', (event) => {
        const { roomId } = JSON.parse(event.data);
        if (roomId !== state.currentRoomId) return;
        loadMessages(roomId, { forceBottom: state.isNearBottom }).catch(() => {});
      });
      for (const eventName of ['room:new', 'room:update', 'room:archive', 'user:new', 'user:update', 'profile:update', 'notifications:update']) {
        state.events.addEventListener(eventName, () => refreshAll().catch(() => {}));
      }
      for (const eventName of ['post:new', 'post:update', 'post:delete']) {
        state.events.addEventListener(eventName, () => {
          if (state.section === 'profile' && state.profile?.id) refreshProfile().catch(() => {});
          if (state.section === 'home') renderModule('home');
        });
      }
    }

