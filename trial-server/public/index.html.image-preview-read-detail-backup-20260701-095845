    function openFilePreview(fileId) {
      const file = findFile(fileId);
      if (!file || !file.canPreview) {
        alert('ไฟล์นี้ไม่รองรับการพรีวิวอย่างปลอดภัย กรุณาดาวน์โหลดไฟล์ต้นฉบับ');
        return;
      }
      if (!isImage(file)) {
        window.open(filePreviewUrl(file), '_blank', 'noopener');
        return;
      }
      const roomScopedItems = file.roomId
        ? mediaItems().filter((item) => item.roomId === file.roomId || item.conversationId === file.roomId)
        : mediaItems();
      const index = roomScopedItems.findIndex((item) => item.id === file.id || item.duplicateIds?.includes(file.id));
      state.lightboxItems = index >= 0 ? roomScopedItems : [file];
      state.lightboxIndex = index >= 0 ? index : 0;
      renderLightbox();
    }
    window.openFilePreview = openFilePreview;

    function openMediaLightbox(index) {
