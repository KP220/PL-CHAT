    }
    .navButton .badge,
    .badge {
      background: #EF4444;
      color: #fff;
      box-shadow: 0 0 0 2px #fff;
    }

    .chatListPane {
      padding: 0;
      border-right: 1px solid var(--pl-line-border);
      background: var(--pl-line-list-bg);
    }
    .paneTitle {
      height: 52px;
      margin: 0;
      padding: 0 14px;
      border-bottom: 1px solid var(--pl-line-border);
      background: #fff;
    }
    .paneTitle h2 {
      font-size: 16px;
