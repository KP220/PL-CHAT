<body>
  <div id="notificationToastStack" class="notificationToastStack" aria-live="polite" aria-label="การแจ้งเตือนใหม่"></div>
  <div class="shell">
    <header class="topbar">
      <img class="mark" src="/logo.png" alt="PL CHAT">
      <div class="brand">
        <h1>PL CHAT</h1>
        <p>Internal Workspace</p>
      </div>
      <div id="status" class="status">ยังไม่ได้เข้าสู่ระบบ</div>
      <div id="topActions" class="topActions hidden">
        <button id="notificationButton" class="secondary" type="button">แจ้งเตือน <span id="notificationBadge" class="badge hidden">0</span></button>
        <div id="notificationDropdown" class="dropdown hidden"></div>
      </div>
    </header>

    <main id="auth" class="auth">
      <h2 id="authTitle">สมัครสมาชิก PL CHAT</h2>
      <p id="authSubtitle">สมัครด้วยอีเมลส่วนตัว ระบบจะส่งลิงก์ยืนยันอีเมลก่อนเข้าใช้งาน</p>
      <form id="authForm" class="stack" autocomplete="on">
        <div id="messageBox" class="hidden"></div>
        <input id="name" name="name" placeholder="ชื่อที่แสดงในแชท" autocomplete="name">
        <input id="email" name="username" type="email" inputmode="email" placeholder="อีเมลส่วนตัว" autocomplete="username email" autocapitalize="none" spellcheck="false">
        <input id="password" name="password" type="password" placeholder="รหัสผ่านอย่างน้อย 8 ตัว" autocomplete="current-password">
        <label id="rememberDeviceWrap" class="rememberDevice hidden">
          <input id="rememberDevice" type="checkbox">
          <span>จำอุปกรณ์นี้และเข้าสู่ระบบอัตโนมัติ</span>
        </label>
        <button id="primaryButton" type="submit">สมัครและส่งลิงก์ยืนยัน</button>
        <button id="secondaryButton" class="secondary" type="button">มีบัญชีแล้ว เข้าสู่ระบบ</button>
