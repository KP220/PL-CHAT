    async function publishDesktopUpdateFromAdmin() {
      const versionInput = $('hostReleaseVersion')?.value.trim() || '';
      const version = versionInput.match(/\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?/)?.[0] || '';
      const releaseNotes = $('hostReleaseNotes')?.value.trim() || '';
      const file = $('hostReleaseInstaller')?.files?.[0];
      const notice = $('hostReleaseNotice');
      if (!version) {
        alert('กรุณาใส่เลขเวอร์ชัน เช่น 1.0.2');
        return;
      }
      if (!file) {
        alert('กรุณาเลือกไฟล์ installer .exe');
        return;
      }
      if (!file.name.toLowerCase().endsWith('.exe')) {
        alert('ไฟล์ installer ต้องเป็น .exe');
        return;
      }
      if (!confirm(`Publish ${file.name} เป็นเวอร์ชัน ${version} หรือไม่?`)) return;
      if (notice) notice.textContent = 'กำลังอัปโหลด installer ไปยังโฮสต์...';
      const params = new URLSearchParams({ version, fileName: file.name, releaseNotes });
      try {
        const headers = { 'Content-Type': 'application/octet-stream' };
        if (state.token) headers.Authorization = `Bearer ${state.token}`;
        const response = await fetch(`/api/admin/desktop-update/publish?${params.toString()}`, {
          method: 'POST',
          credentials: 'same-origin',
          headers,
          body: file
        });
        const body = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(body.error || body.message || 'publish_failed');
        if (notice) notice.textContent = `Published ${body.latestVersion || version} (${formatBytes(body.sizeBytes)})`;
        await loadHostAdminPanel();
      } catch (error) {
        if (notice) notice.textContent = friendlyError(error.message);
        alert(friendlyError(error.message));
      }
    }

