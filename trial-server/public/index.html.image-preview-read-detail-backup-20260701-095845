    function renderOpsMonitoring(data) {
      const panel = $('moduleOpsMonitoring');
      if (!panel) return;
      const storage = data.storage || {};
      const transfers = data.transfers || {};
      const flags = data.flags || {};
      const disk = storage.dataDir || {};
      const temp = storage.tempDir || {};
      const uploadDrivers = Object.entries(storage.uploads?.byDriver || {}).map(([driver, value]) => (
        `<div class="settingRow"><span><strong>${escapeHtml(driver)}</strong><small>${value.count} ไฟล์</small></span><strong>${formatBytes(value.bytes || 0)}</strong></div>`
      )).join('');
      panel.innerHTML = `
        <div class="postCard">
          <strong>Phase F Monitoring</strong>
          <div class="hint">อัปเดตล่าสุด ${formatTime(data.generatedAt)} · ${escapeHtml(data.publicUrl || '')}</div>
          ${(data.alerts || []).map((alert) => `<div class="notice" style="border-color:${alert.level === 'critical' ? '#dc2626' : '#d97706'};margin-top:8px;"><strong>${alert.level === 'critical' ? 'Critical' : 'Warning'}:</strong> ${escapeHtml(alert.message)}</div>`).join('')}
          <div class="grid cards">
            <div class="card"><strong>${storage.uploads?.total || 0}</strong><span>ไฟล์ทั้งหมด</span></div>
            <div class="card"><strong>${storage.uploads?.totalGb || 0} GB</strong><span>พื้นที่ไฟล์</span></div>
            <div class="card"><strong>${disk.usedPercent ?? '-'}%</strong><span>ดิสก์ข้อมูล</span></div>
            <div class="card"><strong>${transfers.chunkUploads?.abandoned || 0}</strong><span>คิวค้าง</span></div>
          </div>
          <div class="settingRow"><span><strong>พื้นที่ข้อมูล</strong><small>${escapeHtml(disk.path || '')}</small></span><strong>${disk.freeGb ?? '-'} GB free</strong></div>
          <div class="settingRow"><span><strong>พื้นที่ temp upload</strong><small>${escapeHtml(temp.path || '')}</small></span><strong>${temp.freeGb ?? '-'} GB free</strong></div>
          ${uploadDrivers || '<div class="hint">ยังไม่มีไฟล์ใน storage</div>'}
        </div>
        <div class="postCard">
