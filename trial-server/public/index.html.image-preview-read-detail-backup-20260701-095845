    async function loadDesktopUpdateStatus() {
      const updater = desktopUpdater();
      const [status, history, manifest] = await Promise.all([
        updater?.getUpdateStatus ? updater.getUpdateStatus().catch(() => null) : Promise.resolve(null),
        updater?.getUpdateHistory ? updater.getUpdateHistory().catch(() => null) : Promise.resolve(null),
        api('/api/desktop/update-manifest').catch(() => null)
      ]);
      state.desktopUpdateStatus = status?.status || null;
      state.desktopUpdateHistory = history?.history || [];
      state.desktopUpdateManifest = manifest;
      if (state.desktopUpdateManifest?.latestVersion && state.desktopInfo?.appVersion) {
        const available = compareVersions(state.desktopUpdateManifest.latestVersion, state.desktopInfo.appVersion) > 0 && state.desktopUpdateManifest.fileExists;
        state.desktopUpdateStatus = {
          ...(state.desktopUpdateStatus || {}),
          available,
          version: state.desktopUpdateManifest.latestVersion,
          message: available ? 'มีเวอร์ชันใหม่จากเครื่องโฮสต์' : 'ไม่มีเวอร์ชันใหม่บนเครื่องโฮสต์'
        };
      } else if (state.desktopUpdateManifest?.latestVersion) {
        state.desktopUpdateStatus = {
          ...(state.desktopUpdateStatus || {}),
          available: Boolean(state.desktopUpdateManifest.fileExists),
          version: state.desktopUpdateManifest.latestVersion,
          message: state.desktopUpdateManifest.fileExists ? 'พบ installer ล่าสุดบนเครื่องโฮสต์' : 'ยังไม่มี installer บนโฮสต์'
        };
      }
      renderDesktopUpdateBadges();
      return state.desktopUpdateStatus;
    }

    function compareVersions(a, b) {
      const left = String(a || '0').split('.').map((part) => Number(part) || 0);
      const right = String(b || '0').split('.').map((part) => Number(part) || 0);
      const length = Math.max(left.length, right.length);
      for (let index = 0; index < length; index += 1) {
        const diff = (left[index] || 0) - (right[index] || 0);
        if (diff) return diff;
      }
      return 0;
    }

