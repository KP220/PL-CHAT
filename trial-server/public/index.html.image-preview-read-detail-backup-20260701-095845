    function renderModule(section) {
      if (section === 'home') return renderHomeWorkspace();
      if (section === 'people') return renderPeopleWorkspace();
      if (section === 'media') return renderMediaWorkspace();
      if (section === 'notifications') return renderNotificationsWorkspace();
