      }
      if (!state.notificationSettings.desktopNotificationEnabled) return;
      if (!('Notification' in window) || Notification.permission !== 'granted') return;
      const notification = new Notification(item.title || 'PL CHAT', {
        body,
        tag: item.id,
        renotify: false
      });
      notification.onclick = () => {
        window.focus();
        openNotification(item);
        notification.close();
      };
    }

