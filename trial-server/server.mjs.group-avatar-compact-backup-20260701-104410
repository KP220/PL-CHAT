async function markRoomReadForUser(room, user) {
  let receipt = state.readReceipts.find((item) => item.roomId === room.id && item.userId === user.id);
  if (!receipt) {
    receipt = { id: cryptoId(), roomId: room.id, userId: user.id, readAt: nowIso(), createdAt: nowIso() };
