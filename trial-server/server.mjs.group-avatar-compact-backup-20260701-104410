function normalizeRemoteAddress(value) {
  return String(value || '')
    .replace(/^::ffff:/, '')
    .replace(/^\[|\]$/g, '');
}

function isPrivateLanAddress(value) {
  const address = normalizeRemoteAddress(value);
  if (!address || address === '::1' || address === '127.0.0.1' || address === 'localhost') return true;
  const parts = address.split('.').map((part) => Number(part));
  if (parts.length !== 4 || parts.some((part) => !Number.isInteger(part) || part < 0 || part > 255)) return false;
  if (parts[0] === 10) return true;
  if (parts[0] === 172 && parts[1] >= 16 && parts[1] <= 31) return true;
  if (parts[0] === 192 && parts[1] === 168) return true;
  if (parts[0] === 169 && parts[1] === 254) return true;
  return false;
}

function allowLanRequest(request) {
  if (!lanOnlyAccess) return true;
  return isPrivateLanAddress(request.socket?.remoteAddress);
}

function isTryCloudflareOrigin(value) {
  try {
    return new URL(value).hostname.endsWith('.trycloudflare.com');
  } catch {
    return false;
  }
}

function allowedOrigins() {
  const values = new Set(configuredAllowedOrigins);
  const publicOrigin = configuredPublicOrigin();
  if (publicOrigin && isTryCloudflareOrigin(publicOrigin)) {
    for (const value of [...values]) {
      if (isTryCloudflareOrigin(value) && value !== publicOrigin) values.delete(value);
    }
  }
  if (publicOrigin) values.add(publicOrigin);
  values.add(`http://localhost:${port}`);
  values.add(`http://127.0.0.1:${port}`);
  return [...values].filter(Boolean);
}

function corsHeaders(request = null) {
  const values = allowedOrigins();
  const requestOrigin = String(request?.headers?.origin || '').trim().replace(/\/+$/, '');
  const origin = requestOrigin
    ? (values.includes(requestOrigin) ? requestOrigin : '')
    : (configuredPublicOrigin() || values[0] || '');
  return origin ? { 'Access-Control-Allow-Origin': origin, Vary: 'Origin' } : { Vary: 'Origin' };
}

function securityHeaders(extra = {}) {
  return {
    'X-Content-Type-Options': 'nosniff',
    'X-Frame-Options': 'DENY',
    'Referrer-Policy': 'no-referrer',
    'Permissions-Policy': 'camera=(), microphone=(), geolocation=()',
    'Cross-Origin-Resource-Policy': 'same-origin',
    ...extra
  };
}

function isLocalUrl(value) {
  return /^https?:\/\/(localhost|127\.0\.0\.1|0\.0\.0\.0|192\.168\.|10\.|172\.(1[6-9]|2\d|3[0-1])\.)/i.test(String(value || ''));
}

function isTrustedDeviceLocalHost(hostname) {
  return ['localhost', '127.0.0.1', '::1', '[::1]'].includes(String(hostname || '').toLowerCase());
}

function isTrustedDeviceRuntimeHost(hostname) {
  const value = String(hostname || '').toLowerCase();
  return isTrustedDeviceLocalHost(value) || value.endsWith('.trycloudflare.com');
}

function trustedDeviceSurfaceAllowed(request) {
  const origin = String(request.headers.origin || '').trim();
  if (origin) {
    try {
      const parsed = new URL(origin);
      return (parsed.protocol === 'https:' && isTrustedDeviceRuntimeHost(parsed.hostname)) || isTrustedDeviceLocalHost(parsed.hostname);
    } catch {
      return false;
    }
  }
  const host = String(request.headers.host || '').split(':')[0];
  return isTrustedDeviceRuntimeHost(host);
}

