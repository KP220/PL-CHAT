async function storeUpload({ user, name, dataUrl, roomId = null, postId = null }) {
  const match = String(dataUrl || '').match(/^data:([^;]+);base64,(.+)$/);
  if (!match) {
    const error = new Error('invalid_upload');
    error.statusCode = 400;
    throw error;
  }
  return storeUploadBuffer({
    user,
    name,
    mimeType: match[1],
    buffer: Buffer.from(match[2], 'base64'),
    roomId,
    postId
  });
}

