function validateUploadMetadata({ name, mimeType, size, limitBytes = maxUploadBytes }) {
  const originalName = sanitizeFilename(name);
  if (size > limitBytes) {
    const error = new Error('upload_too_large');
    error.statusCode = 413;
    throw error;
  }
  mimeType = String(mimeType || 'application/octet-stream').slice(0, 160);
  const extension = uploadExtension(originalName);
  if (!allowUnknownFileTypes && getMime(originalName) === 'application/octet-stream' && mimeType === 'application/octet-stream') {
    const error = new Error('file_type_not_allowed');
    error.statusCode = 400;
    throw error;
  }
  return { originalName, mimeType, extension };
}

