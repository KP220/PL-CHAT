    byteSize: size,
    storageKey: safeStorageKey,
    storageDriver,
    objectKey,
    providerUploadId,
    url: storageDriver === 'local' ? `/uploads/${safeStorageKey}` : '',
    roomId,
    conversationId: roomId,
    postId,
    profileUserId,
    deletedAt: null,
    deletedById: null,
    uploadMode: fileUploadMode,
    uploadMethod,
    previewMode: filePreviewMode,
    blockFileExecution,
