  addAudit('file.uploaded', user.id, 'file', upload.id, {
    name: upload.name,
    extension: upload.extension,
    mimeType: upload.mimeType,
    size: upload.size,
    roomId,
    postId,
    profileUserId,
    uploadMethod
  });
  return upload;
}

