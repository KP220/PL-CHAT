  const baseName = basename(original, extension)
    .replace(/[^\x20-\x7E]/g, '_')
    .replace(/[%"'`;\\]/g, '_')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 120);
  const safeBase = /[A-Za-z0-9]/.test(baseName) ? baseName : 'download';
  const safeExtension = extension.replace(/[^A-Za-z0-9.]/g, '').slice(0, 24);
