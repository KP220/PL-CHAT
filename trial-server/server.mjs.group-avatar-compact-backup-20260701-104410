async function storeUploadStream({ user, name, request, mimeType = 'application/octet-stream', roomId = null, postId = null, profileUserId = null, limitBytes = directUploadMaxBytes }) {
  const originalName = sanitizeFilename(name || 'file');
  const extension = uploadExtension(originalName);
  const fileName = `${Date.now()}-${cryptoId()}${extension}`;
  const filePath = join(uploadDir, fileName);
  let written = 0;
  try {
    written = await writeRequestToFile(request, filePath, limitBytes);
    validateUploadMetadata({ name: originalName, mimeType, size: written });
    const upload = createUploadRecord({
      user,
      name: originalName,
      mimeType,
