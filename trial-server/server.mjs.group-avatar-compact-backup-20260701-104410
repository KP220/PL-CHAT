function getActionDetails(targetType, targetId, viewer) {
  const groups = {
    reactions: [],
    acknowledgements: [],
    replies: [],
    forwards: [],
    edits: [],
    reads: []
  };
  let target = null;

  if (targetType === 'message') {
    target = state.messages.find((item) => item.id === targetId && !item.deletedAt);
    const room = state.rooms.find((item) => item.id === target?.roomId);
    if (!target || !canAccessRoom(room, viewer.id) || messageHiddenForUser(target, viewer.id)) return null;

    for (const reaction of target.reactions || []) {
      const entry = actionEntry('reaction', reaction.userId, reaction.createdAt, reaction.emoji, { id: reaction.id, emoji: reaction.emoji });
      groups.reactions.push(entry);
      if (reaction.emoji === 'เธฃเธฑเธเธ—เธฃเธฒเธ') groups.acknowledgements.push(entry);
    }
    for (const reply of state.messages.filter((item) => item.replyToId === target.id && !item.deletedAt && canAccessRoom(state.rooms.find((roomItem) => roomItem.id === item.roomId), viewer.id))) {
      groups.replies.push(actionEntry('reply', reply.userId, reply.createdAt, String(reply.text || reply.attachment?.name || '').slice(0, 180), { id: reply.id, roomId: reply.roomId }));
    }
    for (const forwarded of state.messages.filter((item) => item.forwardedFromId === target.id && !item.deletedAt)) {
      const destination = state.rooms.find((item) => item.id === forwarded.roomId);
      const destinationVisible = canAccessRoom(destination, viewer.id);
      groups.forwards.push(actionEntry('forward', forwarded.userId, forwarded.createdAt, destinationVisible ? destination.name : 'เธซเนเธญเธเธ—เธตเนเธเธณเธเธฑเธ”เธชเธดเธ—เธเธดเน', {
        id: forwarded.id,
        roomId: destinationVisible ? forwarded.roomId : null
      }));
    }
    for (const edit of target.editHistory || []) {
      groups.edits.push(actionEntry('edit', edit.editedById, edit.createdAt, edit.newText || '', {
        id: edit.id,
        oldText: edit.oldText || '',
        newText: edit.newText || ''
      }));
    }
    const createdAt = new Date(target.createdAt || 0).getTime();
    for (const userId of roomRecipientIds(room)) {
      const isSender = userId === target.userId;
      const receipt = state.messageReadReceipts.find((item) => item.messageId === target.id && item.userId === userId);
      const isRead = isSender || Boolean(receipt?.readAt);
      const readAt = isSender ? target.createdAt : receipt?.readAt;
      groups.reads.push(actionEntry(isRead ? 'read' : 'unread', userId, isRead ? readAt : null, isRead ? 'เธญเนเธฒเธเนเธฅเนเธง' : 'เธขเธฑเธเนเธกเนเธญเนเธฒเธ', {
        isRead,
        roomId: room.id
      }));
    }
  } else if (targetType === 'post') {
    target = state.posts.find((item) => item.id === targetId && !item.deletedAt);
    if (!target) return null;
    for (const reaction of target.reactions || []) {
      groups.reactions.push(actionEntry('reaction', reaction.userId, reaction.createdAt, reaction.emoji, { id: reaction.id, emoji: reaction.emoji }));
    }
    for (const reply of state.postComments.filter((item) => item.postId === target.id && !item.deletedAt)) {
      groups.replies.push(actionEntry('comment', reply.userId, reply.createdAt, String(reply.text || '').slice(0, 180), { id: reply.id }));
    }
    for (const edit of target.editHistory || []) {
      groups.edits.push(actionEntry('edit', edit.editedById, edit.createdAt, edit.newText || '', {
        id: edit.id,
        oldText: edit.oldText || '',
        newText: edit.newText || ''
      }));
    }
  } else if (targetType === 'comment') {
    target = state.postComments.find((item) => item.id === targetId && !item.deletedAt);
    if (!target || !state.posts.some((item) => item.id === target.postId && !item.deletedAt)) return null;
    for (const reaction of state.postCommentReactions.filter((item) => item.commentId === target.id)) {
      groups.reactions.push(actionEntry('reaction', reaction.userId, reaction.createdAt, reaction.emoji, { id: reaction.id, emoji: reaction.emoji }));
    }
    for (const reply of state.postComments.filter((item) => item.replyToCommentId === target.id && !item.deletedAt)) {
      groups.replies.push(actionEntry('reply', reply.userId, reply.createdAt, String(reply.text || '').slice(0, 180), { id: reply.id }));
    }
    for (const edit of target.editHistory || []) {
      groups.edits.push(actionEntry('edit', edit.editedById, edit.createdAt, edit.newText || '', {
        id: edit.id,
        oldText: edit.oldText || '',
        newText: edit.newText || ''
      }));
    }
  } else {
    return null;
  }

  const summary = Object.fromEntries(Object.entries(groups).map(([key, values]) => [key, values.length]));
  return { targetType, targetId, summary, groups };
}

