async function publishDesktopUpdateFromRequest(request, user, url) {
  const version = normalizeDesktopVersion(url.searchParams.get('version') || request.headers['x-release-version'] || '');
  if (!validDesktopVersion(version)) {
    const error = new Error('invalid_version');
    error.statusCode = 400;
    throw error;
  }
  const rawFileName = url.searchParams.get('fileName') || request.headers['x-file-name'] || defaultDesktopInstallerName(version);
  let fileName = safeUpdateFileName(rawFileName);
  if (!fileName.toLowerCase().endsWith('.exe')) fileName = `${fileName}.exe`;
  if (!fileName || fileName === '.exe') {
    const error = new Error('invalid_file_name');
    error.statusCode = 400;
    throw error;
  }
  const releaseNotes = String(url.searchParams.get('releaseNotes') || request.headers['x-release-notes'] || '').slice(0, 2000);
  await mkdir(desktopUpdateDir, { recursive: true });
  const temporaryFile = join(desktopUpdateDir, `${fileName}.uploading-${process.pid}-${cryptoId()}`);
  const finalFile = join(desktopUpdateDir, fileName);
  let sizeBytes = 0;
  try {
    sizeBytes = await writeRequestToFile(request, temporaryFile, desktopUpdateMaxBytes);
    if (!sizeBytes) {
      const error = new Error('empty_installer');
      error.statusCode = 400;
      throw error;
    }
    await copyFile(temporaryFile, finalFile);
  } finally {
    await rm(temporaryFile, { force: true }).catch(() => {});
  }
  const sha256 = await sha256File(finalFile);
  const manifest = {
    version,
    channel: 'lan-manual',
    fileName,
    sizeBytes,
    sha256,
    releaseNotes,
    publishedAt: nowIso(),
    publishedBy: user.id
  };
  await writeFile(desktopUpdateManifestFile, `${JSON.stringify(manifest, null, 2)}\n`, 'utf8');
  addAudit('desktop_update.published', user.id, 'desktop_update', version, {
    fileName,
    sizeBytes,
