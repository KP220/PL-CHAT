function bytesToGb(bytes) {
  return Math.round((Number(bytes || 0) / 1024 / 1024 / 1024) * 100) / 100;
}

async function directoryDiskSummary(targetDir) {
  try {
    const { statfs } = await import('node:fs/promises');
    const stats = await statfs(targetDir);
    const totalBytes = Number(stats.blocks || 0) * Number(stats.bsize || 0);
    const freeBytes = Number(stats.bavail || stats.bfree || 0) * Number(stats.bsize || 0);
    const usedBytes = Math.max(totalBytes - freeBytes, 0);
    return {
      path: targetDir,
      totalGb: bytesToGb(totalBytes),
      usedGb: bytesToGb(usedBytes),
      freeGb: bytesToGb(freeBytes),
      usedPercent: totalBytes ? Math.round((usedBytes / totalBytes) * 10000) / 100 : null
    };
  } catch (error) {
    return { path: targetDir, error: error?.message || 'disk_unavailable' };
  }
}

function uploadStatusSummary(items, staleHours = 24) {
  const cutoff = Date.now() - staleHours * 60 * 60 * 1000;
  const active = items.filter((item) => !item.completedAt && !item.cancelledAt && !item.deletedAt);
  return {
    total: items.length,
    active: active.length,
    completed: items.filter((item) => item.completedAt || item.status === 'completed').length,
    cancelled: items.filter((item) => item.cancelledAt || item.status === 'cancelled').length,
    failed: items.filter((item) => /failed|error/i.test(String(item.status || ''))).length,
    abandoned: active.filter((item) => new Date(item.updatedAt || item.createdAt || 0).getTime() < cutoff).length
  };
}

function auditCountSince(prefixes, sinceMs) {
  return state.auditLog.filter((item) => {
    const createdAt = new Date(item.createdAt || 0).getTime();
    return createdAt >= sinceMs && prefixes.some((prefix) => String(item.action || '').startsWith(prefix));
  }).length;
}


async function cleanupAbandonedUploads(user, staleHours = 24) {
  const cutoff = Date.now() - Math.max(1, Number(staleHours || 24)) * 60 * 60 * 1000;
  const stale = (item) => {
    if (item.completedAt || item.cancelledAt) return false;
    const updatedAt = new Date(item.updatedAt || item.createdAt || 0).getTime();
    return updatedAt < cutoff && Number(item.uploadedBytes || 0) === 0;
  };
  const chunkSessions = (state.chunkUploads || []).filter(stale);
  const multipartSessions = (state.multipartUploads || []).filter(stale);
  for (const session of chunkSessions) {
    await cleanupChunkUpload(session.id);
    session.status = 'cancelled';
    session.cancelledAt = nowIso();
    session.updatedAt = nowIso();
    session.cancelReason = 'admin_abandoned_cleanup';
  }
  for (const session of multipartSessions) {
    if (session.objectKey && session.providerUploadId && s3MultipartStorage?.ready) {
      await s3MultipartStorage.abortMultipartUpload({
        key: session.objectKey,
        uploadId: session.providerUploadId
      }).catch(() => {});
    }
    session.status = 'cancelled';
    session.cancelledAt = nowIso();
    session.updatedAt = nowIso();
    session.cancelReason = 'admin_abandoned_cleanup';
  }
  addAudit('ops.abandoned_uploads.cleaned', user.id, 'upload_session', null, {
    staleHours,
    chunkUploadIds: chunkSessions.map((item) => item.id),
    multipartUploadIds: multipartSessions.map((item) => item.id)
  });
  await saveState();
  return {
    ok: true,
    staleHours,
    cleaned: chunkSessions.length + multipartSessions.length,
    chunkUploads: chunkSessions.length,
    multipartUploads: multipartSessions.length
  };
}


async function checkS3LiveHealth() {
  if (!s3MultipartStorage?.ready) return false;
  const endpoint = String(process.env.S3_ENDPOINT || '').replace(/\/+$/, '');
  if (!endpoint) return false;
  try {
    const response = await fetch(`${endpoint}/minio/health/live`, {
      signal: AbortSignal.timeout(3000)
    });
    return response.ok;
  } catch {
    return false;
  }
}

async function opsMonitoringSummary(request) {
  const now = Date.now();
  const dataDirDisk = await directoryDiskSummary(dataDir);
  const uploads = state.uploads.filter((item) => !item.deletedAt);
  const uploadsByDriver = uploads.reduce((acc, item) => {
    const key = item.storageDriver || 'local';
    acc[key] ||= { count: 0, bytes: 0 };
    acc[key].count += 1;
    acc[key].bytes += Number(item.size || 0);
    return acc;
  }, {});
  const recentAudit = state.auditLog
    .slice(-80)
    .reverse()
    .filter((item) => /^file\.|^chat\.|^auth\./.test(String(item.action || '')))
    .slice(0, 20)
    .map((item) => ({
      action: item.action,
      entityType: item.entityType,
      entityId: item.entityId,
      userId: item.userId,
      createdAt: item.createdAt,
      metadata: item.metadata || {}
    }));
  const lastHour = now - 60 * 60 * 1000;
  const lastDay = now - 24 * 60 * 60 * 1000;
  const repositoryStatus = await repository.status();
  const s3Live = await checkS3LiveHealth();
  const alerts = [];
  const diskUsedPercent = Number(dataDirDisk.usedPercent || 0);
  if (diskUsedPercent >= 90) alerts.push({ level: 'critical', code: 'disk_critical', message: `Disk usage is ${diskUsedPercent}%.` });
  else if (diskUsedPercent >= 80) alerts.push({ level: 'warning', code: 'disk_warning', message: `Disk usage is ${diskUsedPercent}%.` });
  const chunkSummary = uploadStatusSummary(state.chunkUploads || []);
  const multipartSummary = uploadStatusSummary(state.multipartUploads || []);
  if (chunkSummary.abandoned + multipartSummary.abandoned > 0) {
    alerts.push({ level: 'warning', code: 'abandoned_uploads', message: `${chunkSummary.abandoned + multipartSummary.abandoned} abandoned upload session(s).` });
  }
  if (!s3Live) alerts.push({ level: 'critical', code: 's3_unavailable', message: 'MinIO/S3 storage is unavailable.' });

  return {
    ok: true,
    generatedAt: nowIso(),
    service: 'pl-chat-internal-workspace',
    publicUrl: getRequestBaseUrl(request),
    flags: {
      fileStorageDriver,
      enableChunkUpload,
      enableDirectUpload,
      enableMultipartUpload,
      enableResumableUpload,
      enablePersistentUploadQueue,
      enableSignedDirectDownload: Boolean(enableSignedDirectDownload && s3MultipartStorage?.publicReady),
      s3PublicTransferReady: Boolean(s3MultipartStorage?.publicReady),
      enableDesktopParallelDownload,
      repositoryMode: repositoryStatus.mode || repositoryStatus.source || 'json',
      repositoryEnabled: Boolean(repositoryStatus.enabled),
      s3Configured: Boolean(s3MultipartStorage?.ready),
      s3Ready: s3Live
    },
    storage: {
      dataDir: dataDirDisk,
      tempDir: await directoryDiskSummary(uploadTempDir),
      uploadDir: await directoryDiskSummary(uploadDir),
      uploads: {
        total: uploads.length,
        totalGb: bytesToGb(uploads.reduce((total, item) => total + Number(item.size || 0), 0)),
        byDriver: uploadsByDriver
      }
    },
    transfers: {
      lastHour: {
        signedDownloads: auditCountSince(['file.signed_download.created'], lastHour),
        legacyDownloads: auditCountSince(['file.downloaded'], lastHour),
        chunkCompleted: auditCountSince(['file.chunk_upload.completed'], lastHour),
        multipartCompleted: auditCountSince(['file.multipart_upload.completed'], lastHour),
        directUploaded: auditCountSince(['file.uploaded'], lastHour)
      },
      lastDay: {
        signedDownloads: auditCountSince(['file.signed_download.created'], lastDay),
        legacyDownloads: auditCountSince(['file.downloaded'], lastDay),
        chunkCompleted: auditCountSince(['file.chunk_upload.completed'], lastDay),
        multipartCompleted: auditCountSince(['file.multipart_upload.completed'], lastDay),
        directUploaded: auditCountSince(['file.uploaded'], lastDay)
      },
      chunkUploads: uploadStatusSummary(state.chunkUploads || []),
      multipartUploads: uploadStatusSummary(state.multipartUploads || [])
    },
    limits: {
      uploadMaxMb: maxUploadBytes / 1024 / 1024,
      chunkSizeMb,
      multipartMinFileSizeMb,
      maxMultipartUploadMb: Math.round(maxMultipartUploadBytes / 1024 / 1024),
      uploadQueueConcurrency,
      uploadRetryLimit,
      signedDownloadExpiresMinutes
    },
    alerts,
    recentAudit
  };
}

const server = createServer(async (request, response) => {
  response.plChatRequest = request;
  try {
    const url = new URL(request.url, `http://${request.headers.host}`);
    if (!allowLanRequest(request)) {
      if (url.pathname.startsWith('/api/')) {
        return sendError(response, 403, 'lan_only', 'PL CHAT LAN v1 accepts private LAN clients only.');
      }
      response.writeHead(403, {
        'Content-Type': 'text/plain; charset=utf-8',
        'Cache-Control': 'no-store',
        ...securityHeaders()
      });
      response.end('PL CHAT LAN v1 accepts private LAN clients only.');
      return;
    }
    if (url.pathname.startsWith('/api/')) {
      return await handleApi(request, response);
    }
    return await serveStatic(request, response);
  } catch (error) {
    console.error(error);
    if (response.headersSent || response.writableEnded) {
      if (!response.writableEnded) response.end();
      return;
    }
    return sendError(response, error.statusCode || 500, error.message || 'server_error', 'PL CHAT server error.');
  }
});

