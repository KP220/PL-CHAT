  providerUploadId = null,
  limitBytes = maxUploadBytes
}) {
  const { originalName, mimeType: safeMimeType, extension } = validateUploadMetadata({ name, mimeType, size, limitBytes });
  const safeStorageKey = storageKey || objectKey;
  const upload = {
    id: cryptoId(),
    organizationId: defaultOrganizationId,
