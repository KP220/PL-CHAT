  if (!directUploadUserIds.size && !directUploadUserEmails.size) return true;
  const normalizedEmail = normalizeEmail(user.email || '');
  return directUploadUserIds.has(user.id) || (!!normalizedEmail && directUploadUserEmails.has(normalizedEmail));
}

function clampUploadConcurrency(value) {
  return Math.max(uploadMinConcurrency, Math.min(uploadMaxConcurrency, value || uploadDefaultConcurrency));
}

function clampMultipartUploadConcurrency(value, min = uploadMinConcurrency) {
  return Math.max(min, Math.min(uploadMaxConcurrency, value || uploadDefaultConcurrency));
}

function isQuickTunnelRequest(request) {
  const requestBaseUrl = getRequestBaseUrl(request);
  return isTryCloudflareOrigin(requestBaseUrl) || isTryCloudflareOrigin(s3MultipartStorage?.publicEndpoint || '');
}

function multipartConcurrencyPlan(request, requestedConcurrency = 0) {
  const quickTunnel = isQuickTunnelRequest(request);
  const requested = Number(requestedConcurrency || 0);
  const primary = quickTunnel && !requested
    ? quickTunnelMultipartConcurrency
    : (requested || uploadDefaultConcurrency);
  const fallback = quickTunnel
    ? quickTunnelMultipartFallbackConcurrency
    : [];
  return {
    primary: clampMultipartUploadConcurrency(primary, quickTunnel ? 1 : uploadMinConcurrency),
    fallback: [...new Set(fallback.map((value) => clampMultipartUploadConcurrency(value, 1)))].filter((value) => value > 0),
    route: quickTunnel ? 'quick_tunnel' : 'standard',
    reason: quickTunnel ? 'quick_tunnel_minio_signed_multipart_benchmark' : 'configured_default'
  };
}

function transferAutoTunePlan(request) {
  const quickTunnel = isQuickTunnelRequest(request);
  const selectedChunkSizeMb = quickTunnel
    ? Math.min(Math.max(chunkSizeMb, 16), 32)
    : chunkSizeMb;
  const selectedUploadQueueConcurrency = quickTunnel
    ? Math.min(uploadQueueConcurrency, 2)
    : uploadQueueConcurrency;
  return {
    enabled: true,
    route: quickTunnel ? 'quick_tunnel' : 'standard',
    reason: quickTunnel ? 'quick_tunnel_stability' : 'configured_default',
    chunkSizeMb: selectedChunkSizeMb,
    chunkSizeBytes: selectedChunkSizeMb * 1024 * 1024,
    uploadQueueConcurrency: selectedUploadQueueConcurrency
  };
}

function resolveMultipartPartSize(fileSize) {
  const minBytes = Math.max(5, multipartMinPartSizeMb) * 1024 * 1024;
  const maxBytes = Math.max(multipartMaxPartSizeMb, multipartMinPartSizeMb) * 1024 * 1024;
  const defaultBytes = Math.max(multipartDefaultPartSizeMb, multipartMinPartSizeMb) * 1024 * 1024;
  const requested = Math.max(defaultBytes, Math.ceil(Number(fileSize || 0) / 10000));
  return Math.max(minBytes, Math.min(maxBytes, requested));
}

function multipartThresholdBytes() {
  return Math.max(1, multipartMinFileSizeMb) * 1024 * 1024;
}

function multipartObjectKey({ user, roomId, name }) {
