  return sendError(response, 404, 'file_original_missing', missingStoredUploadMessage(upload));
}

async function sendStoredUpload(response, upload, { disposition = 'attachment', request = null } = {}) {
  if (upload.storageDriver && upload.storageDriver !== 'local') {
    if (upload.storageDriver !== 's3' || !s3MultipartStorage?.ready || !upload.objectKey) {
      return sendError(response, 409, 'storage_unavailable', 'The file storage service is not available.');
    }
    const signedUrl = s3MultipartStorage.presignDownload({
      key: upload.objectKey,
      fileName: upload.name || 'download',
      mimeType: upload.mimeType || 'application/octet-stream',
      disposition,
      expiresSeconds: 900
    });
    response.writeHead(302, {
      Location: signedUrl,
      'Cache-Control': 'private, no-store',
      ...securityHeaders({ 'Cross-Origin-Resource-Policy': 'cross-origin' })
    });
    response.end();
    return;
  }
  const storageKey = upload.storageKey || basename(String(upload.url || '').replace(/^\/uploads\//, ''));
  if (!storageKey) {
    return sendMissingStoredUpload(response, upload);
  }
  const filePath = join(uploadDir, storageKey);
  const resolvedFile = resolve(filePath);
  const resolvedUploads = resolve(uploadDir);
  if (!resolvedFile.startsWith(resolvedUploads)) {
    response.writeHead(403);
    response.end();
    return;
  }
  let fileInfo;
  try {
    fileInfo = await stat(filePath);
  } catch (error) {
    if (isMissingLocalFileError(error)) {
      return sendMissingStoredUpload(response, upload);
    }
    throw error;
  }
  const totalSize = fileInfo.size;
  const requestedRange = request?.headers?.range;
  const range = parseRangeHeader(request?.headers?.range, totalSize);
  if (requestedRange && !range) {
    response.writeHead(416, {
      'Content-Range': `bytes */${totalSize}`,
      'Accept-Ranges': 'bytes',
      'Cache-Control': 'private, no-store',
      ...securityHeaders()
    });
    response.end();
    return;
  }
  const start = range?.start ?? 0;
  const end = range?.end ?? totalSize - 1;
  const status = range ? 206 : 200;
  const contentLength = range ? end - start + 1 : totalSize;
  const headers = {
    'Content-Type': upload.mimeType || upload.type || getMime(upload.name),
    'Cache-Control': 'private, no-store',
    ...securityHeaders(),
    'Content-Disposition': contentDispositionHeader(disposition, upload.name),
    'Content-Length': String(contentLength),
    'Accept-Ranges': 'bytes'
  };
  if (range) headers['Content-Range'] = `bytes ${start}-${end}/${totalSize}`;
  response.writeHead(status, headers);
  const stream = createReadStream(filePath, range ? { start, end } : {});
  stream.on('error', (error) => {
    if (response.writableEnded || response.destroyed) return;
    if (!response.headersSent) {
      const missingFile = isMissingLocalFileError(error);
      response.writeHead(missingFile ? 404 : 500, {
        'Content-Type': 'application/json; charset=utf-8',
        'Cache-Control': 'private, no-store',
        ...securityHeaders()
      });
      response.end(JSON.stringify({
        ok: false,
        error: missingFile ? 'file_original_missing' : 'file_stream_error',
        message: missingFile ? missingStoredUploadMessage(upload) : 'PL CHAT could not read this file.'
      }));
      return;
    }
    response.destroy(error);
  });
  stream.pipe(response);
}

function parseRangeHeader(rangeHeader, totalSize) {
  const value = String(rangeHeader || '').trim();
  if (!value || !value.startsWith('bytes=')) return null;
  const [rawStart, rawEnd] = value.slice(6).split('-', 2);
  let start = rawStart === '' ? NaN : Number(rawStart);
  let end = rawEnd === '' ? totalSize - 1 : Number(rawEnd);
  if (rawStart === '' && Number.isFinite(end)) {
    start = Math.max(totalSize - end, 0);
    end = totalSize - 1;
  }
  if (!Number.isFinite(start) || !Number.isFinite(end) || start < 0 || end < start || start >= totalSize) return null;
  return { start, end: Math.min(end, totalSize - 1) };
}

async function handleApi(request, response) {
  if (request.method === 'OPTIONS') return sendJson(response, 204, {});

  const url = new URL(request.url, `http://${request.headers.host}`);
  const path = url.pathname;

  if (request.method === 'GET' && path.startsWith('/api/actions/')) {
    const user = getUser(request);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    const [, , , targetType, targetId] = path.split('/');
    const details = getActionDetails(targetType, targetId, user);
    if (!details) return sendError(response, 404, 'action_target_not_found', 'Action details are unavailable or access is denied.');
    return sendJson(response, 200, { ok: true, ...details });
  }

  if (request.method === 'GET' && path === '/api/desktop/update-manifest') {
    const user = getUser(request);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    return sendJson(response, 200, await readDesktopUpdateManifest(request));
  }

  if (request.method === 'GET' && path === '/api/desktop/update-feed') {
    return sendJson(response, 200, await readDesktopUpdateManifest(request, { useRequestOrigin: true }));
  }

  if ((request.method === 'GET' || request.method === 'HEAD') && (path === '/api/desktop/update-installer' || path.startsWith('/api/desktop/update-installer/'))) {
    return sendDesktopUpdateInstaller(request, response);
  }


  if (request.method === 'POST' && path === '/api/admin/ops/cleanup-abandoned') {
    const user = getUser(request);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    if (!isAdmin(user)) return sendError(response, 403, 'admin_required', 'Admin access required.');
    const body = await readJson(request).catch(() => ({}));
    const staleHours = Math.min(Math.max(Number(body.staleHours || 24), 1), 168);
    return sendJson(response, 200, await cleanupAbandonedUploads(user, staleHours));
  }

  if (request.method === 'GET' && path === '/api/admin/ops/monitoring') {
    const user = getUser(request);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    if (!isAdmin(user)) return sendError(response, 403, 'admin_required', 'Admin access required.');
    return sendJson(response, 200, await opsMonitoringSummary(request));
  }

  if (request.method === 'GET' && path === '/api/admin/host/status') {
    const user = getUser(request);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    if (!isAdmin(user)) return sendError(response, 403, 'admin_required', 'Admin access required.');
    return sendJson(response, 200, await hostAdminStatus(request));
  }

  if (request.method === 'POST' && path === '/api/admin/desktop-update/publish') {
    const user = getUser(request);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    if (!isAdmin(user)) return sendError(response, 403, 'admin_required', 'Admin access required.');
    try {
      return sendJson(response, 200, await publishDesktopUpdateFromRequest(request, user, url));
    } catch (error) {
      return sendError(response, error.statusCode || 500, error.message || 'publish_failed', error.message || 'Could not publish installer.');
    }
  }

  if (request.method === 'POST' && path === '/api/admin/host/backup') {
    const user = getUser(request);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    if (!isAdmin(user)) return sendError(response, 403, 'admin_required', 'Admin access required.');
    return sendJson(response, 200, await createHostBackup(user));
  }

  if (request.method === 'POST' && path === '/api/admin/host/restart-request') {
    const user = getUser(request);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    if (!isAdmin(user)) return sendError(response, 403, 'admin_required', 'Admin access required.');
    const marker = join(dataDir, 'restart-request.json');
    await writeFile(marker, `${JSON.stringify({ requestedAt: nowIso(), requestedBy: user.id }, null, 2)}\n`, 'utf8');
    addAudit('host.restart.requested', user.id, 'host', 'pl-chat-server', { marker });
    await saveState();
    return sendJson(response, 200, { ok: true, marker, message: 'Restart request recorded. Restart the host service or PowerShell process manually.' });
  }

  if (request.method === 'GET' && path === '/api/health') {
    const repositoryStatus = await repository.status();
    const user = getUser(request);
    if (!user) {
      return sendJson(response, 200, {
        ok: true,
        service: 'pl-chat-internal-workspace',
        generatedAt: nowIso()
      });
    }
    const multipartEnabledForUser = Boolean(enableMultipartUpload && s3MultipartStorage?.publicReady && directMultipartEnabledForUser(user));
    const concurrencyPlan = multipartConcurrencyPlan(request);
    const transferPlan = transferAutoTunePlan(request);
    return sendJson(response, 200, {
      ok: true,
      service: 'pl-chat-internal-workspace',
      urls: getLanUrls(),
      lanOnlyAccess,
      smtpConfigured: Boolean(process.env.SMTP_HOST),
      appPublicUrl: getRequestBaseUrl(request),
      emailVerificationRequired: requireVerifiedEmail,
      uploadMaxMb: maxUploadBytes / 1024 / 1024,
      directUploadMaxMb: directUploadMaxBytes / 1024 / 1024,
      fileUploadMode,
      filePreviewMode,
      enableChunkUpload,
      enableMultipartUpload: multipartEnabledForUser,
      enableResumableUpload,
      enablePersistentUploadQueue,
      enableSignedDirectDownload: Boolean(enableSignedDirectDownload && s3MultipartStorage?.publicReady),
      s3PublicTransferReady: Boolean(s3MultipartStorage?.publicReady),
      enableDesktopParallelDownload,
      signedDownloadExpiresMinutes,
      transferAutoTuning: transferPlan,
      chunkSizeMb: transferPlan.chunkSizeMb,
      chunkSizeBytes: transferPlan.chunkSizeBytes,
      multipartMinFileSizeMb,
      multipartThresholdBytes: multipartThresholdBytes(),
      multipartDefaultPartSizeMb,
      multipartMinPartSizeMb,
      multipartMaxPartSizeMb,
      maxMultipartUploadMb: Math.round(maxMultipartUploadBytes / 1024 / 1024),
      uploadQueueConcurrency: transferPlan.uploadQueueConcurrency,
      multipartUploadConcurrency: concurrencyPlan.primary,
      multipartUploadConcurrencyFallback: concurrencyPlan.fallback,
      multipartUploadConcurrencyRoute: concurrencyPlan.route,
      multipartUploadConcurrencyReason: concurrencyPlan.reason,
      uploadRetryLimit,
      chunkUploadExpiresHours,
      repository: repositoryStatus
    });
  }
  if (request.method === 'POST' && path === '/api/auth/register') return handleRegister(request, response);

  if (request.method === 'GET' && path === '/api/auth/verify-email') {
    const token = url.searchParams.get('token') || '';
    const match = findUsableToken(state.emailVerificationTokens, token);
    if (!match.ok) return sendError(response, 400, match.reason, 'Verification link is invalid, expired, or already used.');
    const user = state.users.find((item) => item.id === match.item.userId);
    if (!user) return sendError(response, 404, 'user_not_found', 'User not found.');
    match.item.usedAt = nowIso();
    user.emailVerifiedAt = user.emailVerifiedAt || nowIso();
    addAudit('auth.email_verified', user.id, 'user', user.id);
    await saveState();
    broadcast('user:update', { user: publicUser(user) });
    return sendJson(response, 200, { ok: true, user: publicUser(user) });
  }

  if (request.method === 'POST' && path === '/api/auth/resend-verification') {
    const body = await readJson(request);
    const email = normalizeEmail(body.email);
    const user = state.users.find((item) => item.email === email);
    if (user && !user.emailVerifiedAt) {
      const recent = state.emailVerificationTokens.filter((item) => item.userId === user.id && new Date(item.createdAt).getTime() > Date.now() - 60_000);
      if (recent.length < 2) await sendVerificationEmail(request, user);
    }
    await saveState();
    return sendJson(response, 200, { ok: true, message: 'If this email needs verification, a new link has been sent.' });
  }

  if (request.method === 'POST' && path === '/api/auth/send-verification-email') {
    const user = getUser(request);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    if (user.emailVerifiedAt) return sendJson(response, 200, { ok: true, message: 'Email already verified.' });
    const mail = await sendVerificationEmail(request, user);
    await saveState();
    return sendJson(response, 200, { ok: true, mailSent: mail.sent, publicUrlWarnings: mail.warnings || [] });
  }

  if (request.method === 'POST' && path === '/api/auth/forgot-password') {
    const body = await readJson(request);
    const email = normalizeEmail(body.email);
    const user = state.users.find((item) => item.email === email);
    if (user) {
      const recent = state.passwordResetTokens.filter((item) => item.userId === user.id && new Date(item.createdAt).getTime() > Date.now() - 60_000);
      if (recent.length < 2) await sendPasswordResetEmail(request, user);
    }
    await saveState();
    return sendJson(response, 200, { ok: true, message: 'If the email exists, reset instructions have been sent.' });
  }

  if (request.method === 'POST' && path === '/api/auth/reset-password') {
    const body = await readJson(request);
    const password = String(body.password || '');
    if (password.length < 8) return sendError(response, 400, 'weak_password', 'Password must be at least 8 characters.');
    const match = findUsableToken(state.passwordResetTokens, String(body.token || ''));
    if (!match.ok) return sendError(response, 400, match.reason, 'Reset link is invalid, expired, or already used.');
    const user = state.users.find((item) => item.id === match.item.userId);
    if (!user) return sendError(response, 404, 'user_not_found', 'User not found.');
    match.item.usedAt = nowIso();
    user.passwordHash = hashPassword(password);
    user.passwordChangedAt = nowIso();
    state.sessions = state.sessions.filter((session) => session.userId !== user.id);
    state.trustedDevices = state.trustedDevices.filter((device) => device.userId !== user.id);
    addAudit('auth.password_reset', user.id, 'user', user.id);
    await saveState();
    return sendJson(response, 200, { ok: true });
  }

  if (request.method === 'POST' && path === '/api/auth/login') {
    const body = await readJson(request);
    const email = normalizeEmail(body.email);
    const password = String(body.password || '');
    const user = state.users.find((item) => item.email === email);

    if (!user || !verifyPassword(password, user.passwordHash)) {
      return sendError(response, 401, 'invalid_login', 'Invalid email or password.');
    }
    if (requireVerifiedEmail && !user.emailVerifiedAt) {
      return sendError(response, 403, 'email_not_verified', 'Please verify your email before logging in.');
    }

    let trustedDevice = null;
    if (Boolean(body.rememberDevice) && trustedDeviceSurfaceAllowed(request)) {
      trustedDevice = createTrustedDevice(user, request, body.deviceLabel);
    }
    const session = createSession(user, { trustedDeviceId: trustedDevice?.device.id || null });
    user.lastLoginAt = nowIso();
    touchPresence(user, 'online');
    addAudit('auth.login', user.id, 'user', user.id, { trustedDevice: Boolean(trustedDevice) });
    await saveState();
    return sendJson(response, 200, {
      ok: true,
      token: session.token,
      expiresAt: session.expiresAt,
      trustedDeviceToken: trustedDevice?.token || null,
      trustedDeviceExpiresAt: trustedDevice?.device.expiresAt || null,
      user: publicUser(user)
    }, { 'Set-Cookie': sessionCookie(session) });
  }

  if (request.method === 'POST' && path === '/api/auth/trusted-device') {
    if (!trustedDeviceSurfaceAllowed(request)) {
      return sendError(response, 403, 'trusted_device_surface_denied', 'Trusted device auto login is only available from secure PL CHAT runtime origins.');
    }
    const body = await readJson(request);
    const device = findTrustedDevice(String(body.trustedDeviceToken || ''));
    if (!device) return sendError(response, 401, 'trusted_device_invalid', 'Trusted device is expired or no longer trusted.');
    const user = state.users.find((item) => item.id === device.userId);
    if (!user) return sendError(response, 401, 'trusted_device_invalid', 'Trusted device is expired or no longer trusted.');
    if (requireVerifiedEmail && !user.emailVerifiedAt) return sendError(response, 403, 'email_not_verified', 'Please verify your email before logging in.');
    device.lastUsedAt = nowIso();
    const session = createSession(user, { trustedDeviceId: device.id });
    user.lastLoginAt = nowIso();
    touchPresence(user, 'online');
    addAudit('auth.trusted_device_login', user.id, 'trusted_device', device.id);
    await saveState();
    return sendJson(response, 200, {
      ok: true,
      token: session.token,
      expiresAt: session.expiresAt,
      trustedDeviceExpiresAt: device.expiresAt,
      user: publicUser(user)
    }, { 'Set-Cookie': sessionCookie(session) });
  }

  if (request.method === 'POST' && path === '/api/auth/trusted-device/revoke') {
    const body = await readJson(request).catch(() => ({}));
    const token = String(body.trustedDeviceToken || '');
    if (token) {
      const device = findTrustedDevice(token);
      if (device) {
        device.revokedAt = nowIso();
        addAudit('auth.trusted_device_revoked', device.userId, 'trusted_device', device.id);
      }
    }
    await saveState();
    return sendJson(response, 200, { ok: true }, { 'Set-Cookie': clearSessionCookie() });
  }

  if (request.method === 'POST' && path === '/api/auth/logout') {
    return sendJson(response, 200, { ok: true }, { 'Set-Cookie': clearSessionCookie() });
  }

  if (request.method === 'GET' && path === '/api/auth/session-status') {
    const candidates = getTokenCandidates(request);
    const matched = candidates.map((candidate) => {
      const session = state.sessions.find((item) => item.token === candidate.token);
      return {
        source: candidate.source,
        present: true,
        matched: Boolean(session),
        expired: session ? new Date(session.expiresAt).getTime() < Date.now() : null
      };
    });
    const session = getSession(request);
    return sendJson(response, 200, {
      ok: true,
      authenticated: Boolean(session),
      source: session?.authSource || null,
      sources: matched,
      hasAnyToken: candidates.length > 0
    }, session ? { 'Set-Cookie': sessionCookie(session) } : {});
  }

  if (request.method === 'GET' && path === '/api/me') {
    const session = getSession(request);
    if (!session) return sendError(response, 401, 'unauthorized', 'Login required.');
    const user = state.users.find((item) => item.id === session.userId);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    touchPresence(user, 'online');
    session.lastUsedAt = nowIso();
    await saveState();
    return sendJson(response, 200, {
      ok: true,
      token: session.token,
      expiresAt: session.expiresAt,
      user: publicUser(user)
    }, { 'Set-Cookie': sessionCookie(session) });
  }

  if (request.method === 'PATCH' && (path === '/api/me' || path === '/api/me/profile')) {
    const user = getUser(request);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    const body = await readJson(request);
    user.name = String(body.name || body.displayName || user.name).trim().slice(0, 80);
    user.bio = String(body.bio || '').trim().slice(0, 300);
    if (Object.hasOwn(body, 'avatar')) user.avatar = String(body.avatar || '').trim().slice(0, 300);
    if (Object.hasOwn(body, 'cover')) user.cover = String(body.cover || '').trim().slice(0, 300);
    if (Object.hasOwn(body, 'statusMessage')) user.statusMessage = String(body.statusMessage || '').trim().slice(0, 140);
    if (Object.hasOwn(body, 'department')) user.department = String(body.department || '').trim().slice(0, 80);
    if (Object.hasOwn(body, 'jobTitle')) user.jobTitle = String(body.jobTitle || '').trim().slice(0, 80);
    if (Object.hasOwn(body, 'accentColor')) user.accentColor = String(body.accentColor || '').trim().slice(0, 32);
    if (Object.hasOwn(body, 'favoriteQuote')) user.favoriteQuote = String(body.favoriteQuote || '').trim().slice(0, 160);
    if (Object.hasOwn(body, 'workMood')) user.workMood = String(body.workMood || '').trim().slice(0, 80);
    addAudit('profile.updated', user.id, 'user', user.id, { name: user.name, hasAvatar: Boolean(user.avatar), hasCover: Boolean(user.cover) });
    await saveState();
    broadcast('profile:update', { user: publicUser(user) });
    return sendJson(response, 200, { ok: true, user: publicUser(user) });
  }

  if (request.method === 'PATCH' && path === '/api/me/status') {
    const user = getUser(request);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    const body = await readJson(request);
    user.statusMessage = String(body.statusMessage || body.status || '').trim().slice(0, 140);
    if (Object.hasOwn(body, 'workMood')) user.workMood = String(body.workMood || '').trim().slice(0, 80);
    addAudit('profile.status_updated', user.id, 'user', user.id, { statusMessage: user.statusMessage, workMood: user.workMood || '' });
    await saveState();
    broadcast('profile:update', { user: publicUser(user) });
    return sendJson(response, 200, { ok: true, user: publicUser(user) });
  }

  if (request.method === 'POST' && (path === '/api/profile/avatar' || path === '/api/me/profile-image')) {
    const user = getUser(request);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    const fileName = url.searchParams.get('name') || request.headers['x-file-name'] || 'profile.png';
    const extension = uploadExtension(fileName);
    const mimeType = String(request.headers['content-type'] || '').toLowerCase();
    const allowedExtensions = ['.jpg', '.jpeg', '.png'];
    const allowedMimeTypes = ['image/jpeg', 'image/png', 'application/octet-stream'];
    if (!allowedExtensions.includes(extension) || !allowedMimeTypes.includes(mimeType || 'application/octet-stream')) {
      return sendError(response, 400, 'avatar_type_not_allowed', 'Profile image must be JPG or PNG.');
    }
    const buffer = await readBinary(request, Math.min(maxUploadBytes, 10 * 1024 * 1024));
    const upload = await storeUploadBuffer({
      user,
      name: fileName,
      mimeType: mimeType || getMime(fileName),
      buffer,
      profileUserId: user.id
    });
    user.avatarFileId = upload.id;
    user.avatar = `/api/files/${upload.id}/preview`;
    addAudit('profile.avatar_uploaded', user.id, 'file', upload.id);
    await saveState();
    broadcast('profile:update', { user: publicUser(user) });
    return sendJson(response, 201, { ok: true, user: publicUser(user), file: publicUpload(upload) });
  }

  if (request.method === 'DELETE' && path === '/api/me/profile-image') {
    const user = getUser(request);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    user.avatar = '';
    user.avatarFileId = null;
    addAudit('profile.avatar_deleted', user.id, 'user', user.id);
    await saveState();
    broadcast('profile:update', { user: publicUser(user) });
    return sendJson(response, 200, { ok: true, user: publicUser(user) });
  }

  if (request.method === 'POST' && path === '/api/me/cover-image') {
    const user = getUser(request);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    const fileName = url.searchParams.get('name') || request.headers['x-file-name'] || 'cover.png';
    const extension = uploadExtension(fileName);
    const mimeType = String(request.headers['content-type'] || '').toLowerCase();
    const allowedExtensions = ['.jpg', '.jpeg', '.png', '.webp'];
    const allowedMimeTypes = ['image/jpeg', 'image/png', 'image/webp', 'application/octet-stream'];
    if (!allowedExtensions.includes(extension) || !allowedMimeTypes.includes(mimeType || 'application/octet-stream')) {
      return sendError(response, 400, 'cover_type_not_allowed', 'Cover image must be JPG, PNG, or WEBP.');
    }
    const buffer = await readBinary(request, Math.min(maxUploadBytes, 10 * 1024 * 1024));
    const upload = await storeUploadBuffer({
      user,
      name: fileName,
      mimeType: mimeType || getMime(fileName),
      buffer,
      profileUserId: user.id
    });
    user.coverFileId = upload.id;
    user.cover = `/api/files/${upload.id}/preview`;
    addAudit('profile.cover_uploaded', user.id, 'file', upload.id);
    await saveState();
    broadcast('profile:update', { user: publicUser(user) });
    return sendJson(response, 201, { ok: true, user: publicUser(user), file: publicUpload(upload) });
  }

  if (request.method === 'DELETE' && path === '/api/me/cover-image') {
    const user = getUser(request);
    if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
    user.cover = '';
    user.coverFileId = null;
    addAudit('profile.cover_deleted', user.id, 'user', user.id);
    await saveState();
    broadcast('profile:update', { user: publicUser(user) });
    return sendJson(response, 200, { ok: true, user: publicUser(user) });
  }

  if (request.method === 'GET' && path.startsWith('/api/users/') && path.endsWith('/profile')) {
    const user = getUser(request);
