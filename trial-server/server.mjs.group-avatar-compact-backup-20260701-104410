      const item = getPresence(user.id);
      item.lastSeenAt = nowIso();
      item.updatedAt = nowIso();
      await saveState();
      broadcast('presence:update', { userId: user.id, presence: publicPresence(item) });
    });
    return;
  }

  return sendError(response, 404, 'not_found', 'API not found.');
}

