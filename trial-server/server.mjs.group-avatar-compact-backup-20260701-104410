    concurrencyFallback: Array.isArray(session.recommendedConcurrencyFallback) ? session.recommendedConcurrencyFallback : [],
    concurrencyRoute: session.recommendedConcurrencyRoute || 'standard',
    concurrencyReason: session.recommendedConcurrencyReason || 'configured_default',
    expiresAt: session.expiresAt
  };
}

