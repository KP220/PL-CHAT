function publicPost(post, user = null) {
  const authorId = post.authorId || post.userId;
  const profileOwnerId = post.profileOwnerId || post.userId || post.authorId;
  const author = state.users.find((item) => item.id === authorId);
  const comments = state.postComments
    .filter((comment) => comment.postId === post.id && !comment.deletedAt)
    .sort((a, b) => new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime())
    .map((comment) => ({
      ...publicPostComment(comment),
      canManage: user ? canManagePostComment(comment, user) : false,
      canReply: user ? (post.authorId || post.userId) === user.id : false
    }));
  const reactions = Array.isArray(post.reactions) ? post.reactions : [];
  return {
    id: post.id,
    userId: profileOwnerId,
    authorId,
    profileOwnerId,
    text: post.text || post.content || '',
