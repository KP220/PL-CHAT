  const smtpUser = process.env.SMTP_USER;
  const smtpPass = process.env.SMTP_PASSWORD || process.env.SMTP_PASS;
  const smtpFrom = process.env.SMTP_FROM || smtpUser;
  const smtpPort = Number(process.env.SMTP_PORT || 587);
  const secure = String(process.env.SMTP_SECURE || '').toLowerCase() === 'true' || smtpPort === 465;

  if (!smtpHost || !smtpFrom) {
    return { sent: false, reason: 'smtp_not_configured' };
  }

  let socket = await smtpConnect({ host: smtpHost, port: smtpPort, secure });
  await smtpCommand(socket, null, [220]);
  await smtpCommand(socket, `EHLO ${process.env.COMPUTERNAME || 'pl-chat'}`, [250]);

  const requireTls = String(process.env.SMTP_REQUIRE_TLS || process.env.SMTP_STARTTLS || 'true').toLowerCase() !== 'false';
  if (!secure && requireTls) {
    await smtpCommand(socket, 'STARTTLS', [220]);
    socket = tls.connect({ socket, servername: smtpHost });
    await new Promise((resolve) => socket.once('secureConnect', resolve));
    await smtpCommand(socket, `EHLO ${process.env.COMPUTERNAME || 'pl-chat'}`, [250]);
