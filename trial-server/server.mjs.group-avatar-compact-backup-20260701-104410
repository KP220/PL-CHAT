    const body = await readJson(request);
    const requestedIds = [...new Set(Array.isArray(body.messageIds) ? body.messageIds.map(String).slice(0, 200) : [])];
    const readAt = nowIso();
    const changedRoomIds = new Set();
    const dbRoomMembers = new Map();
    let marked = 0;
    const dbResult = await repository.markMessagesRead(user, requestedIds);
    if (dbResult) {
      marked += dbResult.marked || 0;
      for (const room of dbResult.rooms || []) {
        changedRoomIds.add(room.roomId);
        dbRoomMembers.set(room.roomId, room.memberIds || []);
