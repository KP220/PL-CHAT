    }

    for (const messageId of requestedIds) {
      const message = state.messages.find((item) => item.id === messageId && !item.deletedAt);
      const room = state.rooms.find((item) => item.id === message?.roomId);
      if (!message || message.userId === user.id || !canAccessRoom(room, user.id) || messageHiddenForUser(message, user.id)) continue;
