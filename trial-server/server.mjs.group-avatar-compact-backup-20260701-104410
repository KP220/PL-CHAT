function saveState() {
  const serialized = JSON.stringify(state, null, 2);
  JSON.parse(serialized);

  const sequence = ++saveStateSequence;
  const operation = async () => {
    await mkdir(dataDir, { recursive: true });
    const temporaryFile = `${dataFile}.writing-${process.pid}-${sequence}`;
    const lastGoodFile = `${dataFile}.last-good.json`;
    await writeFile(temporaryFile, serialized, 'utf8');

    try {
      if (existsSync(dataFile)) {
        try {
          JSON.parse(await readFile(dataFile, 'utf8'));
          await copyFile(dataFile, lastGoodFile);
        } catch {
          // Preserve the existing last-good copy when the current data file is invalid.
        }
      }

      await copyFile(temporaryFile, dataFile);
    } finally {
      await rm(temporaryFile, { force: true });
    }
  };

  const queuedSave = saveStateQueue.then(operation, operation);
  saveStateQueue = queuedSave.catch(() => {});
  return queuedSave;
}

