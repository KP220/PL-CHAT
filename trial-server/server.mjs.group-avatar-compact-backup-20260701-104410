function requestCookies(request) {
  return Object.fromEntries(String(request.headers.cookie || '').split(';').map((item) => {
    const [key, ...rest] = item.trim().split('=');
    return [decodeURIComponent(key || ''), decodeURIComponent(rest.join('=') || '')];
  }).filter(([key]) => key));
}

function getTokenCandidates(request) {
  const url = new URL(request.url, `http://${request.headers.host}`);
  const auth = request.headers.authorization || '';
  const cookies = requestCookies(request);
  return [
    { source: 'authorization', token: auth.startsWith('Bearer ') ? auth.slice(7) : '' },
    { source: 'cookie', token: cookies.plchat_session || '' },
    { source: 'query', token: url.searchParams.get('token') || '' }
  ].filter((item) => item.token);
}

function getToken(request) {
  return getTokenCandidates(request)[0]?.token || '';
}

function getSession(request) {
  for (const candidate of getTokenCandidates(request)) {
    const session = state.sessions.find((item) => item.token === candidate.token);
    if (session && new Date(session.expiresAt).getTime() >= Date.now()) {
      session.authSource = candidate.source;
      return session;
    }
  }
  return null;
}

function getUser(request) {
  const session = getSession(request);
  if (!session) return null;
  return state.users.find((user) => user.id === session.userId) || null;
}

function createSession(user, { trustedDeviceId = null } = {}) {
  const token = cryptoId() + cryptoId();
  const expiresAt = new Date(Date.now() + 14 * 24 * 60 * 60 * 1000).toISOString();
  state.sessions.push({
    token,
    userId: user.id,
    trustedDeviceId,
    expiresAt,
    createdAt: nowIso(),
    lastUsedAt: nowIso()
  });
  return { token, expiresAt };
}

function sessionCookie(session) {
  if (!session?.token) return '';
  const maxAge = Math.max(60, Math.floor((new Date(session.expiresAt).getTime() - Date.now()) / 1000));
  return `plchat_session=${encodeURIComponent(session.token)}; Path=/; Max-Age=${maxAge}; SameSite=Lax`;
}

function clearSessionCookie() {
  return 'plchat_session=; Path=/; Max-Age=0; SameSite=Lax';
}

function trustedDeviceLabel(request, label = '') {
  const value = String(label || '').trim().slice(0, 80);
  if (value) return value;
  const userAgent = String(request.headers['user-agent'] || '').slice(0, 80);
  return userAgent || 'Trusted device';
}

function createTrustedDevice(user, request, label = '') {
  const token = createSecretToken() + createSecretToken();
  const device = {
    id: cryptoId(),
    userId: user.id,
    tokenHash: hashToken(token),
    label: trustedDeviceLabel(request, label),
    createdAt: nowIso(),
    lastUsedAt: nowIso(),
    expiresAt: new Date(Date.now() + trustedDeviceExpiresDays * 24 * 60 * 60 * 1000).toISOString()
  };
  state.trustedDevices.push(device);
  return { token, device };
}

function findTrustedDevice(token) {
  const tokenHash = hashToken(token);
  const device = state.trustedDevices.find((item) => item.tokenHash === tokenHash && !item.revokedAt);
  if (!device || isExpired(device)) return null;
  return device;
}

function canAccessRoom(room, userId) {
  if (!room) return false;
  if (room.deletedAt || room.archivedAt) return false;
  if (!Array.isArray(room.memberIds)) return true;
  return room.memberIds.includes(userId);
}

async function findAccessibleRoomForWrite(roomId, user) {
  if (!roomId || !user) return false;
  const room = state.rooms.find((item) => item.id === roomId);
  if (canAccessRoom(room, user.id)) return room;
  const dbRooms = await repository.listRooms(user);
  if (!Array.isArray(dbRooms)) return null;
  return dbRooms.find((item) => item.id === roomId && !item.deletedAt && !item.archivedAt) || null;
}

async function canAccessRoomForWrite(roomId, user) {
  return Boolean(await findAccessibleRoomForWrite(roomId, user));
}

function sanitizeFilename(value) {
  const cleaned = basename(String(value || 'file').replaceAll('\\', '/'))
    .replace(/[\u0000-\u001f\u007f-\u009f<>:"|?*]/g, '_')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 180);
  return cleaned || 'file';
}

function uploadExtension(name) {
  return extname(String(name || '')).toLowerCase().slice(0, 24);
}

function findUploadForAttachment(attachment) {
  if (!attachment) return null;
  return state.uploads.find((item) =>
    item.id === attachment.id ||
    (attachment.url && item.url === attachment.url) ||
    (attachment.storageKey && item.storageKey === attachment.storageKey)
  ) || null;
}

function uploadRoomIds(upload) {
  const ids = new Set();
  if (upload?.roomId) ids.add(upload.roomId);
  if (upload?.conversationId) ids.add(upload.conversationId);
  for (const message of state.messages) {
    const attachment = message.attachment;
    if (!attachment) continue;
    if (attachment.id === upload.id || attachment.url === upload.url || attachment.storageKey === upload.storageKey) {
      ids.add(message.roomId);
    }
  }
  return [...ids];
}

function canAccessUpload(upload, user) {
  if (!upload || !user || upload.deletedAt) return false;
  if ((upload.organizationId || defaultOrganizationId) !== defaultOrganizationId) return false;
  if (upload.profileUserId) return true;
  const roomIds = uploadRoomIds(upload);
  if (!roomIds.length) return upload.userId === user.id;
  return roomIds.some((roomId) => canAccessRoom(state.rooms.find((room) => room.id === roomId), user.id));
}

function canManageUpload(upload, user) {
  if (!upload || !user) return false;
  return upload.userId === user.id || isAdmin(user);
}

function isSafePreview(upload) {
  if (!upload || upload.deletedAt || filePreviewMode !== 'safe-only') return false;
  const type = String(upload.type || upload.mimeType || '').toLowerCase();
  const extension = String(upload.extension || uploadExtension(upload.name)).toLowerCase();
  if (type.startsWith('image/') && ['.png', '.jpg', '.jpeg', '.webp', '.gif'].includes(extension)) return true;
  if (type === 'application/pdf' || extension === '.pdf') return true;
  if (type.startsWith('text/') || ['.txt', '.csv'].includes(extension)) return true;
  return false;
}

function publicUpload(upload) {
  const uploader = state.users.find((user) => user.id === upload.userId);
  const roomId = upload.roomId || uploadRoomIds(upload)[0] || null;
  const room = state.rooms.find((item) => item.id === roomId);
  return {
    id: upload.id,
    organizationId: upload.organizationId || defaultOrganizationId,
    conversationId: upload.conversationId || roomId,
    roomId,
    postId: upload.postId || null,
    messageId: upload.messageId || null,
    name: upload.name,
    originalName: upload.originalName || upload.name,
    type: upload.type || upload.mimeType || 'application/octet-stream',
    mimeType: upload.type || upload.mimeType || 'application/octet-stream',
    extension: upload.extension || uploadExtension(upload.name),
    category: fileCategory(upload),
    size: upload.size,
    byteSize: upload.size,
    uploaderId: upload.userId,
    uploaderName: uploader?.name || 'Unknown user',
    roomName: room?.name || '',
    sourceType: upload.postId ? 'post' : upload.profileField ? 'profile' : roomId ? 'chat' : 'workspace',
    sourceLabel: upload.postId ? 'Shared in post' : upload.profileField ? 'Profile file' : room?.name ? `Shared in chat: ${room.name}` : 'Shared in workspace',
    canPreview: isSafePreview(upload),
    thumbnailUrl: upload.thumbnailKey ? `/api/files/${upload.id}/thumbnail` : null,
    previewUrl: `/api/files/${upload.id}/preview`,
    downloadUrl: `/api/files/${upload.id}/download`,
    shareUrl: `/api/files/${upload.id}/share`,
    createdAt: upload.createdAt,
    deletedAt: upload.deletedAt || null
  };
}

function fileCategory(upload) {
  const ext = String(upload.extension || uploadExtension(upload.name)).toLowerCase();
  const type = String(upload.type || '').toLowerCase();
  if (['.tif', '.tiff', '.psd', '.ai', '.eps', '.dwg', '.dxf', '.fig', '.sketch'].includes(ext)) return 'design';
  if (type.startsWith('image/') || ['.png', '.jpg', '.jpeg', '.webp', '.svg'].includes(ext)) return 'images';
  if (['.pdf', '.doc', '.docx', '.xls', '.xlsx', '.ppt', '.pptx', '.txt', '.csv', '.json', '.xml'].includes(ext)) return 'documents';
  if (['.zip', '.rar', '.7z'].includes(ext)) return 'archives';
  if (type.startsWith('video/') || type.startsWith('audio/') || ['.mp4', '.mov', '.avi', '.webm', '.mp3', '.wav'].includes(ext)) return 'media';
  return 'other';
}

function canGenerateThumbnail(upload) {
  if (!upload || upload.storageDriver !== 'local') return false;
  const type = String(upload.type || upload.mimeType || '').toLowerCase();
  const extension = String(upload.extension || uploadExtension(upload.name)).toLowerCase();
  return type.startsWith('image/') && ['.png', '.jpg', '.jpeg', '.webp', '.gif'].includes(extension);
}

async function createLocalThumbnail(upload, sourcePath) {
  if (!canGenerateThumbnail(upload) || !sourcePath) return null;
  const thumbnailName = `${upload.id}${upload.extension || uploadExtension(upload.name) || '.bin'}`;
  const thumbnailPath = join(thumbnailDir, thumbnailName);
  await copyFile(sourcePath, thumbnailPath);
  upload.thumbnailKey = thumbnailName;
  addAudit('file.thumbnail.created', upload.userId, 'file', upload.id, {
    thumbnailKey: thumbnailName,
    source: upload.storageKey
  });
  return thumbnailName;
}

function isRoomAdmin(room, userId) {
  return room?.ownerId === userId;
}

function canManageRoom(room, user) {
  if (!room || !user || room.deletedAt) return false;
  if (room.id === 'general' && !isAdmin(user)) return false;
  return room.ownerId === user.id || isAdmin(user);
}

function roomRecipientIds(room) {
  if (!room) return [];
  if (Array.isArray(room.memberIds)) return room.memberIds;
  return state.users.map((user) => user.id);
}

function resolveMessageMentionIds(body, text, room, senderId) {
  const roomIds = new Set(roomRecipientIds(room));
  const requested = Array.isArray(body.mentionIds) ? body.mentionIds : [];
  const resolved = new Set(
    requested.filter((id) => id !== senderId && roomIds.has(id) && state.users.some((user) => user.id === id))
  );
  const normalizedText = String(text || '').toLocaleLowerCase();
  for (const user of state.users) {
    if (user.id === senderId || !roomIds.has(user.id)) continue;
    const name = String(user.name || '').trim();
    if (name && normalizedText.includes(`@${name.toLocaleLowerCase()}`)) resolved.add(user.id);
  }
  return [...resolved];
}

function canManageMessage(message, room, user) {
  if (!message || !room || !user || message.deletedAt) return false;
  return message.userId === user.id || isRoomAdmin(room, user.id);
}

function messageHiddenForUser(message, userId) {
  return Boolean(userId && message?.deletedForUserIds?.includes(userId));
}

function getMessagePreview(message) {
  if (!message) return null;
  if (message.deletedAt) {
    return {
      id: message.id,
      name: message.name,
      text: 'This message was unsent.',
      attachmentName: '',
      stickerId: null,
      deleted: true
    };
  }
  return {
    id: message.id,
    name: message.name,
    text: String(message.text || '').slice(0, 160),
    attachmentName: message.attachment?.name || '',
    stickerId: message.stickerId || null,
    deleted: false
  };
}

function publicMessage(message, userId = null) {
  const replyTo = message.replyToId ? state.messages.find((item) => item.id === message.replyToId) : null;
  const forwardedFrom = message.forwardedFromId ? state.messages.find((item) => item.id === message.forwardedFromId) : null;
  const canonicalUpload = message.attachment ? findUploadForAttachment(message.attachment) : null;
  const sender = state.users.find((user) => user.id === message.userId);
  const mentions = (message.mentionIds || [])
    .map((id) => state.users.find((user) => user.id === id))
    .filter(Boolean)
    .map(publicUser);
  if (message.deletedAt) {
    return {
      ...message,
      sender: sender ? publicUser(sender) : null,
      text: '',
      attachment: null,
      stickerId: null,
      reactions: [],
      mentionIds: message.mentionIds || [],
      mentions,
      replyTo: getMessagePreview(replyTo),
      forwardedFrom: getMessagePreview(forwardedFrom),
      readState: getMessageReadState(message, userId),
      deletedForMe: messageHiddenForUser(message, userId),
      deleted: true
    };
  }
  return {
    ...message,
    sender: sender ? publicUser(sender) : null,
    attachment: canonicalUpload ? publicUpload(canonicalUpload) : message.attachment,
    reactions: Array.isArray(message.reactions) ? message.reactions : [],
    mentionIds: message.mentionIds || [],
    mentions,
    replyTo: getMessagePreview(replyTo),
    forwardedFrom: getMessagePreview(forwardedFrom),
    readState: getMessageReadState(message, userId),
    deletedForMe: messageHiddenForUser(message, userId),
    edited: Boolean(message.editedAt),
    deleted: false
  };
}

