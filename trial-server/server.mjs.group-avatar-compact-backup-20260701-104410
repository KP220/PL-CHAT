async function writeRequestToFile(request, filePath, limitBytes) {
  await mkdir(dirname(filePath), { recursive: true });
  let size = 0;
  const writer = createWriteStream(filePath, { flags: 'w' });
  request.on('data', (chunk) => {
    size += chunk.length;
    if (size > limitBytes) {
      request.destroy(Object.assign(new Error('upload_too_large'), { statusCode: 413 }));
    }
  });
  await pipeline(request, writer);
  return size;
}

async function appendPartToWriter(partPath, writer) {
  const reader = createReadStream(partPath);
  for await (const chunk of reader) {
    if (!writer.write(chunk)) {
      await once(writer, 'drain');
    }
  }
}

async function cleanupChunkUpload(uploadId) {
  await rm(chunkUploadDir(uploadId), { recursive: true, force: true }).catch(() => {});
}

async function cleanupExpiredChunkUploads() {
  const activeIds = new Set(state.chunkUploads.filter((item) => !isExpired(item) && !item.completedAt && !item.cancelledAt).map((item) => item.id));
  state.chunkUploads = state.chunkUploads.filter((item) => !isExpired(item) || item.completedAt || item.cancelledAt);
  const entries = await readdir(uploadTempDir).catch(() => []);
  await Promise.all(entries.filter((entry) => !activeIds.has(entry)).map((entry) => rm(join(uploadTempDir, entry), { recursive: true, force: true }).catch(() => {})));
}

async function completeChunkUpload(session, user) {
  const finalName = `${Date.now()}-${cryptoId()}${uploadExtension(session.name)}`;
  const finalPath = join(uploadDir, finalName);
  const writer = createWriteStream(finalPath, { flags: 'w' });
  let written = 0;
  try {
    for (let index = 0; index < session.totalParts; index += 1) {
      const partPath = chunkPartPath(session.id, index);
      const partStat = await stat(partPath);
      written += partStat.size;
      await appendPartToWriter(partPath, writer);
    }
    writer.end();
    await once(writer, 'finish');
  } catch (error) {
    writer.destroy();
    await rm(finalPath, { force: true }).catch(() => {});
    throw error;
  }
  if (written !== Number(session.size || 0)) {
    await rm(finalPath, { force: true }).catch(() => {});
    const error = new Error('chunk_size_mismatch');
    error.statusCode = 400;
    throw error;
  }
  const upload = createUploadRecord({
    user,
    name: session.name,
    mimeType: session.mimeType,
    size: written,
    storageKey: finalName,
    roomId: session.roomId || null,
    postId: session.postId || null,
    uploadMethod: 'chunk'
  });
  await createLocalThumbnail(upload, finalPath).catch(() => {});
  session.status = 'completed';
  session.completedAt = nowIso();
  session.fileId = upload.id;
  addAudit('file.chunk_upload.completed', user.id, 'file', upload.id, {
    uploadId: session.id,
    parts: session.totalParts,
    size: written
  });
  await cleanupChunkUpload(session.id);
  return upload;
}

