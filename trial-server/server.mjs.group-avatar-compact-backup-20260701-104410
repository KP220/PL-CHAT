function getPresence(userId) {
  let item = state.presence.find((entry) => entry.userId === userId);
  if (!item) {
    item = {
      userId,
      status: 'offline',
      manualStatus: 'auto',
      lastSeenAt: null,
      lastHeartbeatAt: null,
      updatedAt: nowIso()
    };
    state.presence.push(item);
  }
  return item;
}

function computeStatus(item) {
  if (!item?.lastHeartbeatAt) return 'offline';
  const ageMs = Date.now() - new Date(item.lastHeartbeatAt).getTime();
  if (ageMs > 90_000) return 'offline';
  if (item.manualStatus === 'busy') return 'busy';
  if (ageMs > 5 * 60_000 || item.manualStatus === 'away') return 'away';
  return 'online';
}

function publicPresence(item) {
  return {
    status: computeStatus(item),
    lastSeenAt: item?.lastSeenAt || null,
    lastHeartbeatAt: item?.lastHeartbeatAt || null,
    updatedAt: item?.updatedAt || null
  };
}

function touchPresence(user, status = 'online') {
  const item = getPresence(user.id);
  item.manualStatus = status === 'auto' ? 'auto' : status;
  item.lastHeartbeatAt = nowIso();
  item.lastSeenAt = nowIso();
  item.updatedAt = nowIso();
  return publicPresence(item);
}

function getRoomUnreadCount(roomId, userId) {
  const receipt = state.readReceipts.find((item) => item.roomId === roomId && item.userId === userId);
