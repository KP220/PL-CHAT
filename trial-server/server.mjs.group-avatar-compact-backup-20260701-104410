}

async function serveStatic(request, response) {
  const url = new URL(request.url, `http://${request.headers.host}`);
  const pathname = decodeURIComponent(url.pathname === '/' ? '/index.html' : url.pathname);
  const safePath = pathname.replaceAll('..', '').replaceAll('\\', '/');
  const baseDir = safePath.startsWith('/uploads/') ? dataDir : publicDir;
  const filePath = join(baseDir, safePath);
  const fallbackPath = join(publicDir, 'index.html');

  try {
    if (safePath.startsWith('/uploads/')) {
      const upload = state.uploads.find((item) => item.url === safePath);
      const user = getUser(request);
      if (!user) return sendError(response, 401, 'unauthorized', 'Login required.');
      if (!upload || !canAccessUpload(upload, user)) return sendError(response, 403, 'file_access_denied', 'File access denied.');
      const resolvedFile = resolve(filePath);
      const resolvedUploads = resolve(uploadDir);
      if (!resolvedFile.startsWith(resolvedUploads)) {
        response.writeHead(403);
        response.end();
        return;
      }
      const canInline = url.searchParams.get('download') !== '1' && isSafePreview(upload);
      addAudit(canInline ? 'file.previewed' : 'file.downloaded', user.id, 'file', upload.id, { roomIds: uploadRoomIds(upload), legacyUrl: true });
      await saveState();
      return sendStoredUpload(response, upload, { disposition: canInline ? 'inline' : 'attachment', request });
    }
    const file = await readFile(filePath);
    const upload = safePath.startsWith('/uploads/')
      ? state.uploads.find((item) => item.url === safePath)
      : null;
    const headers = {
      'Content-Type': upload?.type || getMime(filePath),
      'Cache-Control': 'no-store',
      ...securityHeaders()
    };
    if (upload) {
      const disposition = url.searchParams.get('download') === '1' ? 'attachment' : 'inline';
      headers['Content-Disposition'] = contentDispositionHeader(disposition, upload.name);
      headers['Content-Length'] = String(file.length);
    }
    response.writeHead(200, headers);
    response.end(file);
  } catch {
    const file = await readFile(fallbackPath);
    response.writeHead(200, {
      'Content-Type': 'text/html; charset=utf-8',
      'Cache-Control': 'no-store',
      ...securityHeaders()
    });
    response.end(file);
  }
}

function smtpRead(socket) {
  return new Promise((resolve, reject) => {
    let buffer = '';
    const onData = (chunk) => {
      buffer += chunk.toString('utf8');
      const lines = buffer.split(/\r?\n/).filter(Boolean);
      if (lines.length && /^\d{3} /.test(lines[lines.length - 1])) {
        cleanup();
        resolve(buffer);
      }
    };
    const onError = (error) => {
      cleanup();
      reject(error);
    };
    const cleanup = () => {
      socket.off('data', onData);
      socket.off('error', onError);
    };
    socket.on('data', onData);
    socket.on('error', onError);
  });
}

async function smtpCommand(socket, command, expected) {
  if (command) socket.write(`${command}\r\n`);
  const response = await smtpRead(socket);
  const code = Number(response.slice(0, 3));
  if (!expected.includes(code)) {
    throw new Error(`SMTP command failed: ${command || 'connect'} => ${response.trim()}`);
  }
  return response;
}

function smtpConnect({ host: smtpHost, port: smtpPort, secure }) {
  return new Promise((resolve, reject) => {
    const socket = secure
      ? tls.connect({ host: smtpHost, port: smtpPort, servername: smtpHost }, () => resolve(socket))
      : net.connect({ host: smtpHost, port: smtpPort }, () => resolve(socket));
    socket.once('error', reject);
  });
}

function encodeMimeHeader(value) {
  return `=?UTF-8?B?${Buffer.from(String(value), 'utf8').toString('base64')}?=`;
}

function htmlEscape(value) {
  return String(value || '')
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;');
}

async function sendSmtpMail({ to, subject, text, html }) {
