NODE_ENV=production
APP_NAME="PL CHAT"
APP_ENV=production
APP_PUBLIC_URL="https://your-real-domain.com"
# Optional runtime override for the Windows desktop app.
PL_CHAT_DESKTOP_URL="https://your-real-domain.com"

DATABASE_URL="postgresql://user:password@db:5432/pl_chat"

SESSION_SECRET="change-me"
JWT_SECRET="change-me"
AUTH_SECRET="change-me"

PL_CHAT_PORT=8788
PL_CHAT_HOST="127.0.0.1"
PL_CHAT_ALLOWED_ORIGINS="http://localhost:8788"
PL_CHAT_DATA_DIR="pl-chat-data"
# json = use local JSON only, dual = try PostgreSQL reads with JSON fallback, db = prefer PostgreSQL reads
PL_CHAT_DATA_READ_MODE="json"
PL_CHAT_DB_RETRY_MS=30000
PL_CHAT_MAX_JSON_MB=16
PL_CHAT_MAX_UPLOAD_MB=20480
MAX_UPLOAD_SIZE_MB=20480
FILE_UPLOAD_MODE="universal"
FILE_PREVIEW_MODE="safe-only"
ENABLE_CHUNK_UPLOAD=true
CHUNK_SIZE_MB=64
DIRECT_UPLOAD_MAX_MB=100
UPLOAD_QUEUE_CONCURRENCY=3
UPLOAD_RETRY_LIMIT=3
CHUNK_UPLOAD_EXPIRES_HOURS=72
UPLOAD_TEMP_DIR="./pl-chat-data/tmp/uploads"
FILE_STORAGE_DRIVER="local"
ENABLE_DIRECT_UPLOAD="false"
ENABLE_MULTIPART_UPLOAD="false"
QUICK_TUNNEL_MULTIPART_CONCURRENCY=3
QUICK_TUNNEL_MULTIPART_FALLBACK_CONCURRENCY="2,1"
FILE_STORAGE_PATH="./storage/uploads"
FILE_SHARE_LINK_EXPIRES_HOURS=72
CHAT_ATTACHMENT_RETENTION_ENABLED=true
CHAT_ATTACHMENT_DOWNLOAD_EXPIRES_HOURS=72
CHAT_ATTACHMENT_DELETE_GRACE_HOURS=0
CHAT_ATTACHMENT_RETENTION_BATCH_SIZE=100
CHAT_ATTACHMENT_RETENTION_INTERVAL_MINUTES=60
ALLOW_UNKNOWN_FILE_TYPES=true
BLOCK_FILE_EXECUTION=true

S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_SESSION_TOKEN=""
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_BASE_URL=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_REQUIRE_TLS="true"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="PL CHAT <noreply@your-domain.com>"

INVITE_TOKEN_EXPIRES_HOURS=72
EMAIL_VERIFICATION_TOKEN_EXPIRES_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
EMAIL_VERIFICATION_REQUIRED=true

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.2"
ASSISTANT_PORT=8787

# PL CHAT communicates with KAVEEP over HTTP only. Do not mount or import KAVEEP files.
KAVEEP_BASE_URL="http://127.0.0.1:8765"
KAVEEP_SERVICE_TOKEN="replace-with-the-same-service-token-configured-in-kaveep"
KAVEEP_REQUEST_TIMEOUT_MS=90000
KAVEEP_ATTACHMENT_MAX_MB=8
KAVEEP_RATE_LIMIT_PER_MINUTE=10
KAVEEP_TASK_RETENTION_HOURS=168
KAVEEP_AUDIT_RETENTION_DAYS=90
